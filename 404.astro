---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/site.json";

const meta = {
  ...site.meta,
  title: "الصفحة غير موجودة | مؤسسة هدايات التعليمية",
  description: "الصفحة التي تبحث عنها غير موجودة. يمكنك العودة إلى الصفحة الرئيسية لمؤسسة هدايات التعليمية."
};
---

<BaseLayout meta={meta}>
  <main class="not-found-page">
    <section class="not-found-card" aria-labelledby="not-found-title">
      <a href="/" class="not-found-logo-link" aria-label="العودة إلى الرئيسية">
        <img src={site.assets.logoNav} alt="شعار مؤسسة هدايات التعليمية" class="not-found-logo" />
      </a>
      <div class="not-found-code" aria-hidden="true">404</div>
      <h1 id="not-found-title">الصفحة غير موجودة</h1>
      <p>يبدو أن الرابط غير صحيح أو أن الصفحة نُقلت. يمكنك العودة إلى الواجهة الرئيسية ومتابعة تصفح موقع هدايات.</p>
      <a href="/" class="not-found-home-btn">
        <i class="bi bi-house-door" aria-hidden="true"></i>
        <span>العودة إلى الرئيسية</span>
      </a>
    </section>
  </main>
</BaseLayout>
