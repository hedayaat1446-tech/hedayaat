---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/site.json';

const nav = (site.nav || []).filter((x) => x.enabled !== false);
const waDigits = (site.contact.phone || '').replace(/\D/g, '');
const waLink = waDigits ? `https://wa.me/${waDigits}?text=${encodeURIComponent('مرحباً هدايات')}` : null;
const validSocial = (site.contact.social || []).filter((s) => s.url && s.url !== '#');
const hasIban = Boolean(site.contact.iban && !/SA00\s*0000/i.test(site.contact.iban));
const boardReady = Boolean(site.docs?.board?.published && site.docs.board.fileHref);
const reportItems = (site.docs?.reports?.items || []);
---

<BaseLayout meta={site.meta}>
  <a class="skip-link visually-hidden-focusable" href="#main-content">تجاوز إلى المحتوى الرئيسي</a>

  <nav class="navbar navbar-expand-lg fixed-top hdr" aria-label="التنقل الرئيسي">
    <div class="container align-items-center">
      <a class="navbar-brand d-flex align-items-center" href="#home" aria-label="هدايات - بداية الصفحة">
        <img src={site.assets.logoNav} alt="شعار هدايات" width="138" height="86" />
      </a>

      {waLink && (
        <a class="whatsapp-btn d-flex d-lg-none ms-auto me-2" href={waLink} target="_blank" rel="noopener noreferrer" aria-label="تواصل عبر واتساب" title="تواصل عبر واتساب">
          <i class="bi bi-whatsapp" aria-hidden="true"></i>
        </a>
      )}

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="إظهار القائمة">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav nav-rtl mx-auto gap-lg-1">
          {nav.map((item) => (
            <li class="nav-item"><a class="nav-link" href={item.href}>{item.label}</a></li>
          ))}
        </ul>

        {waLink && (
          <div class="d-none d-lg-flex ms-lg-3">
            <a class="whatsapp-btn" href={waLink} target="_blank" rel="noopener noreferrer" aria-label="تواصل عبر واتساب" title="تواصل عبر واتساب">
              <i class="bi bi-whatsapp" aria-hidden="true"></i>
            </a>
          </div>
        )}
      </div>
    </div>
  </nav>

  <main id="main-content">
    <section id="home" class="hero-section" style={{ '--hero-bg': `url(${site.assets.heroBackground})` }}>
      <div class="container">
        <div class="hero-content reveal-on-scroll is-visible">
          <img src={site.assets.logoHero} alt="هدايات" class="hero-logo-img" width="320" height="320" fetchpriority="high" />
          <div class="hero-kicker"><i class="bi bi-lightbulb" aria-hidden="true"></i> محاضرات · ورش عمل · برامج</div>
          <h1 class="hero-title mb-3">{site.hero.headline}</h1>
          <p class="hero-lead mb-0">{site.hero.lead}</p>

          <div class="hero-actions d-flex flex-wrap justify-content-center gap-2 gap-md-3">
            {site.hero.cta.map((b) => (
              <a href={b.href} class={b.variant === 'secondary' ? 'btn-cta-secondary' : 'btn-cta-primary'}>{b.label}</a>
            ))}
          </div>

          <div class="hero-trust" aria-label="معلومات المؤسسة">
            <span><i class="bi bi-patch-check-fill" aria-hidden="true"></i> مؤسسة تعليمية غير ربحية</span>
            <span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> المملكة العربية السعودية</span>
          </div>
        </div>
      </div>
      <div class="hero-accent-strip" aria-hidden="true"></div>
    </section>

    <section id="about" class="ref-wrap alt">
      <span class="brand-pattern" aria-hidden="true"></span>
      <div class="ref-section">
        <div class="ref-section-header">
          <span class="ref-section-eyebrow">هدايات</span>
          <h2 class="ref-section-title">{site.about.title}</h2>
          <p class="ref-section-subtitle">{site.about.subtitle}</p>
        </div>

        <div class="ref-card about-card reveal-on-scroll">
          <div class="about-grid">
            <div class="about-badge">
              <div class="about-badge-icon"><i class="bi bi-patch-check-fill" aria-hidden="true"></i></div>
              <h3>{site.about.cardTitle}</h3>
              <p class="mb-0">{site.about.cardText}</p>
            </div>
            <div class="about-copy">
              <h3>{site.about.textTitle}</h3>
              <p>{site.about.p1}</p>
              <p class="mb-0">{site.about.p2}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="vision" class="ref-wrap">
      <div class="ref-section">
        <div class="ref-section-header">
          <span class="ref-section-eyebrow">وجهتنا</span>
          <h2 class="ref-section-title">{site.vision.title}</h2>
          <p class="ref-section-subtitle">{site.vision.subtitle}</p>
        </div>
        <div class="ref-grid-2">
          {site.vision.items.map((x) => (
            <article class="ref-card ref-feature reveal-on-scroll">
              <div class="icon"><i class={x.icon} aria-hidden="true"></i></div>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="goals" class="ref-wrap alt">
      <div class="ref-section">
        <div class="ref-section-header">
          <span class="ref-section-eyebrow">مسارات الأثر</span>
          <h2 class="ref-section-title">{site.goals.title}</h2>
          <p class="ref-section-subtitle">{site.goals.subtitle}</p>
        </div>
        <div class="ref-grid-4">
          {site.goals.items.map((g) => (
            <article class="ref-card ref-feature goal-card reveal-on-scroll">
              <div class="icon"><i class={g.icon} aria-hidden="true"></i></div>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="values" class="ref-wrap">
      <div class="ref-section">
        <div class="ref-section-header">
          <span class="ref-section-eyebrow">ما نؤمن به</span>
          <h2 class="ref-section-title">{site.values.title}</h2>
          <p class="ref-section-subtitle">{site.values.subtitle}</p>
        </div>
        <div class="ref-grid-3">
          {site.values.items.map((v) => (
            <article class="ref-card ref-feature reveal-on-scroll">
              <div class="icon"><i class={v.icon} aria-hidden="true"></i></div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="board" class="ref-wrap alt">
      <div class="ref-section text-center">
        <div class="ref-section-header">
          <span class="ref-section-eyebrow">الحوكمة</span>
          <h2 class="ref-section-title">{site.docs.board.title}</h2>
          {site.docs.board.subtitle && <p class="ref-section-subtitle">{site.docs.board.subtitle}</p>}
        </div>
        <div class="docs-list reveal-on-scroll">
          {boardReady ? (
            <a href={site.docs.board.fileHref} download class="ref-card ref-link-card">
              <div class="left">
                <div class="icon"><i class="bi bi-file-earmark-person" aria-hidden="true"></i></div>
                <div class="text-start text-md-end">
                  <div class="title">{site.docs.board.buttonLabel}</div>
                  {site.docs.board.buttonHint && <small>{site.docs.board.buttonHint}</small>}
                </div>
              </div>
              <i class="bi bi-download" aria-hidden="true"></i>
            </a>
          ) : (
            <div class="ref-card ref-link-card is-disabled" role="status">
              <div class="left">
                <div class="icon"><i class="bi bi-file-earmark-person" aria-hidden="true"></i></div>
                <div class="text-start text-md-end">
                  <div class="title">{site.docs.board.buttonLabel}</div>
                  <small>سيتم إتاحة الملف المعتمد هنا بعد رفعه من لوحة الإدارة.</small>
                </div>
              </div>
              <span class="status-chip"><i class="bi bi-clock" aria-hidden="true"></i> قريبًا</span>
            </div>
          )}
        </div>
      </div>
    </section>

    <section id="reports" class="ref-wrap">
      <div class="ref-section">
        <div class="ref-section-header text-center">
          <span class="ref-section-eyebrow">الشفافية</span>
          <h2 class="ref-section-title">{site.docs.reports.title}</h2>
          {site.docs.reports.subtitle && <p class="ref-section-subtitle">{site.docs.reports.subtitle}</p>}
        </div>
        <div class="docs-list">
          {reportItems.length ? reportItems.map((r) => r.published && r.fileHref ? (
            <a href={r.fileHref} download class="ref-card ref-link-card reveal-on-scroll">
              <div class="left">
                <div class="icon"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i></div>
                <div class="text-start text-md-end">
                  <div class="title">{r.buttonLabel}</div>
                  {r.buttonHint && <small>{r.buttonHint}</small>}
                </div>
              </div>
              <i class="bi bi-download" aria-hidden="true"></i>
            </a>
          ) : (
            <div class="ref-card ref-link-card is-disabled reveal-on-scroll" role="status">
              <div class="left">
                <div class="icon"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i></div>
                <div class="text-start text-md-end">
                  <div class="title">{r.buttonLabel}</div>
                  <small>سيتم إتاحة التقرير المعتمد هنا بعد رفعه من لوحة الإدارة.</small>
                </div>
              </div>
              <span class="status-chip"><i class="bi bi-clock" aria-hidden="true"></i> قريبًا</span>
            </div>
          )) : (
            <div class="ref-card ref-link-card is-disabled"><span>لا توجد تقارير منشورة حاليًا.</span></div>
          )}
        </div>
      </div>
    </section>

    <section id="contact" class="ref-wrap alt">
      <span class="brand-pattern" aria-hidden="true"></span>
      <div class="ref-section">
        <div class="ref-section-header">
          <span class="ref-section-eyebrow">نرحب بتواصلكم</span>
          <h2 class="ref-section-title">{site.contact.title}</h2>
          <p class="ref-section-subtitle">{site.contact.subtitle}</p>
        </div>

        <div class="contact-container">
          <div class="contact-form reveal-on-scroll">
            <form id="contact-form" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/thank">
              <input type="hidden" name="form-name" value="contact" />
              <p hidden><label>اترك هذا الحقل فارغًا: <input name="bot-field" /></label></p>

              <div class="form-group">
                <label class="form-label" for="name">الاسم الكامل</label>
                <input class="form-input" id="name" name="fullName" type="text" autocomplete="name" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">البريد الإلكتروني</label>
                <input class="form-input" id="email" name="email" type="email" inputmode="email" autocomplete="email" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="subject">موضوع الرسالة</label>
                <input class="form-input" id="subject" name="subject" type="text" />
              </div>
              <div class="form-group">
                <label class="form-label" for="message">نص الرسالة</label>
                <textarea class="form-textarea" id="message" name="message" required></textarea>
              </div>
              <button type="submit" class="btn-form-submit">إرسال الرسالة</button>
            </form>
          </div>

          <div class="contact-info">
            <div class="contact-item reveal-on-scroll">
              <div class="contact-icon"><i class="bi bi-envelope" aria-hidden="true"></i></div>
              <div class="contact-details"><h3>البريد الإلكتروني</h3><p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p></div>
            </div>
            <div class="contact-item reveal-on-scroll">
              <div class="contact-icon"><i class="bi bi-telephone" aria-hidden="true"></i></div>
              <div class="contact-details"><h3>رقم الهاتف / واتساب</h3><p><a href={`tel:${waDigits}`}>{site.contact.phone}</a></p></div>
            </div>
            <div class="contact-item reveal-on-scroll">
              <div class="contact-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></div>
              <div class="contact-details"><h3>العنوان</h3><p>{site.contact.address}</p></div>
            </div>
            {hasIban && (
              <div class="contact-item reveal-on-scroll">
                <div class="contact-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
                <div class="contact-details"><h3>معلومات الحساب البنكي</h3><p>الآيبان: <span dir="ltr">{site.contact.iban}</span></p></div>
              </div>
            )}
            {validSocial.length > 0 && (
              <div class="contact-item reveal-on-scroll">
                <div class="contact-icon"><i class="bi bi-share" aria-hidden="true"></i></div>
                <div class="contact-details">
                  <h3>تابعنا على</h3>
                  <div class="social-icons-row">
                    {validSocial.map((s) => <a href={s.url} target="_blank" rel="noopener noreferrer" class="social-icon-circle" aria-label={s.label}><i class={s.icon} aria-hidden="true"></i></a>)}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-brand-line" aria-hidden="true"></div>
    <div class="footer-top">
      <div class="footer-logos">
        <img src={site.assets.logoNav} alt="شعار هدايات" class="footer-logo" loading="lazy" />
        <img src={site.assets.nationalCenterLogo} alt="شعار المركز الوطني لتنمية القطاع غير الربحي" class="footer-logo" loading="lazy" />
      </div>
      <p class="footer-license">{site.footer.licenseText}</p>
    </div>
    <hr class="footer-divider" />
    <div class="footer-bottom">{site.footer.copyrightText.replace('{year}', String(new Date().getFullYear()))}</div>
  </footer>

  <script is:inline>
    const hdr = document.querySelector('.hdr');
    const updateHeader = () => hdr?.classList.toggle('scrolled', window.scrollY > 24);
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();

    const navCollapse = document.getElementById('navMain');
    document.querySelectorAll('#navMain .nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 992 && navCollapse?.classList.contains('show') && window.bootstrap) {
          window.bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
        }
      });
    });

    const revealEls = document.querySelectorAll('.reveal-on-scroll:not(.is-visible)');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
