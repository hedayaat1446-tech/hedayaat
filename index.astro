---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/site.json';

const nav = (site.nav || []).filter((x) => x.enabled !== false);
const waDigits = (site.contact.phone || '').replace(/\D/g, '');
const waLink = waDigits ? `https://wa.me/${waDigits}?text=${encodeURIComponent('مرحباً هدايات')}` : null;
const validSocial = (site.contact.social || []).filter((s) => s.url && s.url !== '#');
const hasIban = Boolean(site.contact.iban && !/SA00\s*0000/i.test(site.contact.iban));
const boardReady = Boolean(site.docs?.board?.published && site.docs.board.fileHref);
const reportItems = (site.docs?.reports?.items || []);
---

<BaseLayout meta={site.meta}>
  <a class="skip-link visually-hidden-focusable" href="#main-content">تجاوز إلى المحتوى الرئيسي</a>

  <nav class="navbar navbar-expand-lg fixed-top hdr" aria-label="التنقل الرئيسي">
    <div class="container-fluid identity-nav-shell">
      <a class="navbar-brand" href="#home" aria-label="هدايات - بداية الصفحة">
        <img src="/logo-black.png" alt="هدايات" width="110" height="67" />
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="إظهار القائمة">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav nav-rtl mx-auto">
          {nav.map((item) => <li class="nav-item"><a class="nav-link" href={item.href}>{item.label}</a></li>)}
        </ul>
        {waLink && <a class="nav-contact" href={waLink} target="_blank" rel="noopener noreferrer">تواصل معنا</a>}
      </div>
    </div>
  </nav>

  <main id="main-content">
    <section id="home" class="identity-cover" aria-labelledby="hero-title">
      <div class="identity-cover-inner">
        <img src="/identity-lockup.png" alt="هدايات - محاضرات - ورش عمل - برامج" class="identity-lockup" fetchpriority="high" />
        <h1 id="hero-title" class="sr-only">{site.hero.headline}</h1>

        <div class="identity-swatches" aria-label="ألوان هوية هدايات">
          <span class="olive"></span><span class="gold"></span><span class="peach"></span><span class="salmon"></span><span class="dusty"></span><span class="blue"></span>
        </div>

        <img src="/logo-black.png" alt="" class="cover-corner" aria-hidden="true" />
      </div>
    </section>

    <section class="statement-section" aria-label="رسالة هدايات">
      <div class="statement-grid">
        <div class="statement-mark">هدايات</div>
        <div class="statement-copy">
          <p class="section-label">منارة هدى لتعميق الوعي المجتمعي</p>
          <h2>{site.hero.headline}</h2>
          <p>{site.hero.lead}</p>
          <div class="statement-actions">
            {site.hero.cta.map((b) => <a href={b.href} class={b.variant === 'secondary' ? 'identity-link secondary' : 'identity-link'}>{b.label}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="identity-photo-section" aria-label="نموذج بصري من هوية هدايات">
      <img src="/identity-photo-layout.jpg" alt="محاضرة ضمن الأنشطة التعليمية لهدايات" class="identity-photo-layout" loading="lazy" />
    </section>

    <section id="about" class="editorial-section corner-section">
      <img src="/identity-corner.png" alt="" class="side-corner" aria-hidden="true" />
      <div class="editorial-shell">
        <header class="identity-heading">
          <span>هدايات</span>
          <h2>{site.about.title}</h2>
          <p>{site.about.subtitle}</p>
        </header>

        <div class="editorial-columns">
          <article class="editorial-block emphasis">
            <h3>{site.about.cardTitle}</h3>
            <p>{site.about.cardText}</p>
          </article>
          <article class="editorial-block">
            <h3>{site.about.textTitle}</h3>
            <p>{site.about.p1}</p>
            <p>{site.about.p2}</p>
          </article>
        </div>
      </div>
    </section>

    <div class="identity-grid-band" aria-hidden="true"></div>

    <section id="vision" class="editorial-section">
      <div class="editorial-shell">
        <header class="identity-heading">
          <span>وجهتنا</span>
          <h2>{site.vision.title}</h2>
          <p>{site.vision.subtitle}</p>
        </header>
        <div class="vision-columns">
          {site.vision.items.map((x) => (
            <article class="vision-item">
              <div class="vision-number" aria-hidden="true">◆</div>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="goals" class="editorial-section soft-section">
      <div class="editorial-shell">
        <header class="identity-heading">
          <span>مسارات الأثر</span>
          <h2>{site.goals.title}</h2>
          <p>{site.goals.subtitle}</p>
        </header>
        <div class="lined-list goals-list">
          {site.goals.items.map((g, i) => (
            <article class="lined-item">
              <span class="item-index">0{i + 1}</span>
              <div><h3>{g.title}</h3><p>{g.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="values" class="editorial-section">
      <div class="editorial-shell">
        <header class="identity-heading">
          <span>ما نؤمن به</span>
          <h2>{site.values.title}</h2>
          <p>{site.values.subtitle}</p>
        </header>
        <div class="values-grid">
          {site.values.items.map((v) => (
            <article class="value-item"><h3>{v.title}</h3><p>{v.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <div class="identity-grid-panel" aria-hidden="true"></div>

    <section id="board" class="editorial-section docs-section">
      <div class="editorial-shell narrow-shell">
        <header class="identity-heading">
          <span>الحوكمة</span>
          <h2>{site.docs.board.title}</h2>
          {site.docs.board.subtitle && <p>{site.docs.board.subtitle}</p>}
        </header>
        {boardReady ? (
          <a href={site.docs.board.fileHref} download class="document-row"><span>{site.docs.board.buttonLabel}</span><strong>تحميل PDF</strong></a>
        ) : (
          <div class="document-row disabled"><span>{site.docs.board.buttonLabel}</span><strong>قريبًا</strong></div>
        )}
      </div>
    </section>

    <section id="reports" class="editorial-section soft-section docs-section">
      <div class="editorial-shell narrow-shell">
        <header class="identity-heading">
          <span>الشفافية</span>
          <h2>{site.docs.reports.title}</h2>
          {site.docs.reports.subtitle && <p>{site.docs.reports.subtitle}</p>}
        </header>
        <div class="document-list">
          {reportItems.length ? reportItems.map((r) => r.published && r.fileHref ? (
            <a href={r.fileHref} download class="document-row"><span>{r.buttonLabel}</span><strong>تحميل PDF</strong></a>
          ) : (
            <div class="document-row disabled"><span>{r.buttonLabel}</span><strong>قريبًا</strong></div>
          )) : <div class="document-row disabled"><span>لا توجد تقارير منشورة حاليًا.</span><strong>—</strong></div>}
        </div>
      </div>
    </section>

    <section id="contact" class="editorial-section contact-section corner-section">
      <img src="/identity-corner.png" alt="" class="side-corner contact-corner" aria-hidden="true" />
      <div class="editorial-shell">
        <header class="identity-heading">
          <span>نرحب بتواصلكم</span>
          <h2>{site.contact.title}</h2>
          <p>{site.contact.subtitle}</p>
        </header>

        <div class="contact-layout">
          <form class="identity-form" id="contact-form" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/thank">
            <input type="hidden" name="form-name" value="contact" />
            <p hidden><label>اترك هذا الحقل فارغًا: <input name="bot-field" /></label></p>
            <label>الاسم الكامل<input name="fullName" type="text" autocomplete="name" required /></label>
            <label>البريد الإلكتروني<input name="email" type="email" autocomplete="email" required /></label>
            <label>موضوع الرسالة<input name="subject" type="text" /></label>
            <label>نص الرسالة<textarea name="message" required></textarea></label>
            <button type="submit">إرسال الرسالة</button>
          </form>

          <aside class="contact-details-panel">
            <div><span>البريد الإلكتروني</span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div>
            <div><span>رقم الهاتف / واتساب</span><a href={`tel:${waDigits}`}>{site.contact.phone}</a></div>
            <div><span>العنوان</span><p>{site.contact.address}</p></div>
            {hasIban && <div><span>الآيبان</span><p dir="ltr">{site.contact.iban}</p></div>}
            {validSocial.length > 0 && <div class="social-row">{validSocial.map((s) => <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}><i class={s.icon}></i></a>)}</div>}
          </aside>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-pattern" aria-hidden="true"></div>
    <div class="footer-content">
      <img src="/logo-black.png" alt="هدايات" class="footer-hedayaat" />
      <img src={site.assets.nationalCenterLogo} alt="المركز الوطني لتنمية القطاع غير الربحي" class="footer-center-logo" />
      <p>{site.footer.licenseText}</p>
      <small>{site.footer.copyrightText.replace('{year}', String(new Date().getFullYear()))}</small>
    </div>
  </footer>

  <script is:inline>
    const hdr = document.querySelector('.hdr');
    const updateHeader = () => hdr?.classList.toggle('scrolled', window.scrollY > 90);
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
    const navCollapse = document.getElementById('navMain');
    document.querySelectorAll('#navMain .nav-link').forEach((link) => link.addEventListener('click', () => {
      if (window.innerWidth < 992 && navCollapse?.classList.contains('show') && window.bootstrap) window.bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
    }));
  </script>
</BaseLayout>
