---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/site.json";

const waDigits = (site.contact.phone || "").replace(/\D/g, "");
const pillars = site.about.pillars || [];
const tracks = site.programs.tracks || [];
---

<BaseLayout meta={site.meta} lang="ar" dir="rtl">
  <link slot="head" rel="preload" as="image" href="/hero-lighthouse-photo.webp" type="image/webp" fetchpriority="high" />

  <main id="main-content">
    <section id="home" class="hero-section hero-photo">
      <div class="hero-photo-img" aria-hidden="true"></div>
      <div class="container hero-photo-inner">
        <div class="hero-photo-copy">
          <span class="hero-eyebrow">مؤسسة هدايات التعليمية</span>
          <h1 class="hero-photo-title">{site.hero.headline}</h1>
          <p class="hero-photo-lead">{site.hero.lead}</p>
          <div class="hero-photo-actions">
            <a href="#about" class="hp-btn">تعرّف على المؤسسة <i class="bi bi-chevron-left" aria-hidden="true"></i></a>
            <a href="/videos/" class="hp-btn hp-btn--ghost"><i class="bi bi-play-circle" aria-hidden="true"></i> شاهد الفيديو التعريفي</a>
          </div>
        </div>
      </div>
    </section>

    <nav class="qa2 qa2--compact" aria-label="وصول سريع">
      <a class="qa2-card" href="#about"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-info-circle"></i></span><strong>عن هدايات</strong></a>
      <a class="qa2-card" href="#programs"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-book-half"></i></span><strong>البرامج</strong></a>
      <a class="qa2-card" href="/governance/"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-bank2"></i></span><strong>الحوكمة والشفافية</strong></a>
      <a class="qa2-card" href="/participation/"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-people"></i></span><strong>مشاركة المستفيد</strong></a>
    </nav>

    <section id="about" class="home-section">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>{site.about.title}</h2>
          <p>{site.about.subtitle}</p>
        </header>
        <div class="pillars">
          {pillars.map((x, i) => (
            <article class="pillar reveal-on-scroll" style={`--d:${i * 90}ms`}>
              <span class="pillar-icon" aria-hidden="true"><i class={x.icon}></i></span>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="goals" class="home-section home-section--tint">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>{site.goals.title}</h2>
          <p>{site.goals.subtitle}</p>
        </header>
        <ol class="goals-grid">
          {site.goals.items.map((g, i) => (
            <li class="goal-card reveal-on-scroll" style={`--d:${i * 90}ms`}>
              <span class="goal-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="goal-icon" aria-hidden="true"><i class={g.icon}></i></span>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="values" class="home-section">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>{site.values.title}</h2>
          <p>{site.values.subtitle}</p>
        </header>
        <ul class="values-grid">
          {site.values.items.map((v, i) => (
            <li class="value-card reveal-on-scroll" style={`--d:${i * 70}ms`} tabindex="0">
              <span class="value-icon" aria-hidden="true"><i class={v.icon}></i></span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="programs" class="home-section home-section--tint">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>{site.programs.title}</h2>
          <p>{site.programs.subtitle}</p>
        </header>
        <div class="tracks">
          {tracks.map((t, i) => (
            <article class="track-card reveal-on-scroll" style={`--d:${i * 100}ms`}>
              <span class="track-icon" aria-hidden="true"><i class={t.icon}></i></span>
              <div>
                <h3>{t.title}</h3>
                <p class="track-audience"><i class="bi bi-person-check" aria-hidden="true"></i> الفئة المستهدفة: {t.audience}</p>
                <p>{t.text}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="pp-actions reveal-on-scroll">
          <a class="hp-btn" href={site.programs.ctaHref} data-subject={site.programs.ctaLabel}>{site.programs.ctaLabel}</a>
        </div>
        <article id="partners" class="partner-strip reveal-on-scroll">
          <span class="track-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
          <div>
            <h3>{site.partners.cardTitle}</h3>
            <p>{site.partners.cardText}</p>
          </div>
          <a class="hp-btn hp-btn--ghost" href={site.partners.ctaHref} data-subject={site.partners.ctaLabel}>{site.partners.ctaLabel}</a>
        </article>
      </div>
    </section>

    <section id="contact" class="home-section">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>{site.contact.title}</h2>
          <p>{site.contact.subtitle}</p>
        </header>

        <div class="contact-split">
          <div class="contact-form reveal-on-scroll">
            <form id="contact-form" name="contact" method="POST" action="/api/contact">
              <input class="form-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <div class="form-row-2">
                <div class="form-group">
                  <label class="form-label" for="name">الاسم الكامل</label>
                  <input class="form-input" id="name" name="name" type="text" autocomplete="name" maxlength="120" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="email">البريد الإلكتروني</label>
                  <input class="form-input" id="email" name="email" type="email" autocomplete="email" maxlength="254" required dir="ltr" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="subject">موضوع الرسالة</label>
                <input class="form-input" id="subject" name="subject" type="text" maxlength="180" />
              </div>
              <div class="form-group">
                <label class="form-label" for="message">نص الرسالة</label>
                <textarea class="form-textarea" id="message" name="message" maxlength="5000" required></textarea>
              </div>
              <label class="form-consent">
                <input type="checkbox" name="privacyAccepted" value="yes" required />
                <span>اطلعت على <a href="/privacy/">سياسة الخصوصية</a> وأوافق على استخدام بياناتي للتواصل والرد على استفساري فقط.</span>
              </label>
              <button type="submit" class="btn-form-submit">إرسال الرسالة</button>
              <div id="form-status" class="form-status mt-2" role="status" aria-live="polite" aria-atomic="true"></div>
            </form>
          </div>

          <aside class="contact-side reveal-on-scroll" aria-label="معلومات التواصل">
            <a class="contact-line" href={`mailto:${site.contact.email}`}>
              <span class="contact-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
              <span><small>البريد الإلكتروني</small><strong dir="ltr">{site.contact.email}</strong></span>
            </a>
            <a class="contact-line" href={`tel:+${waDigits}`}>
              <span class="contact-icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
              <span><small>الهاتف / واتساب</small><strong dir="ltr">{site.contact.phone}</strong></span>
            </a>
            <a class="contact-line" href={site.contact.locationUrl || "#"} target="_blank" rel="noopener">
              <span class="contact-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
              <span><small>العنوان</small><strong>{site.contact.address}</strong><em>فتح الموقع على الخريطة</em></span>
            </a>
            {site.contact.social?.length > 0 && (
              <div class="contact-social">
                <small>حسابات التواصل الاجتماعي <span dir="ltr">@{site.contact.socialUsername}</span></small>
                <div class="official-social-links" aria-label="حسابات هدايات الرسمية">
                  {site.contact.social.map((account) => (
                    <a class="official-social-link" href={account.url} target="_blank" rel="noopener noreferrer" aria-label={`هدايات على ${account.label}`} title={account.label}>
                      {account.name === "X" ? <span class="social-x-mark" aria-hidden="true">X</span> : <i class={`bi ${account.icon}`} aria-hidden="true"></i>}
                      <span>{account.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </aside>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      // "الاستفسار عن البرامج" / "طلب شراكة" pre-fill the subject of the contact form.
      document.querySelectorAll('[data-subject]').forEach((a) => a.addEventListener('click', () => {
        const subject = document.getElementById('subject');
        if (subject && !subject.value) subject.value = a.dataset.subject;
        setTimeout(() => document.getElementById('name')?.focus({ preventScroll: true }), 600);
      }));

      const contactForm = document.getElementById('contact-form');
      const formStatus = document.getElementById('form-status');
      if (!contactForm || !formStatus) return;
      contactForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!contactForm.reportValidity()) return;
        const submitButton = contactForm.querySelector('button[type="submit"]');
        const originalLabel = submitButton?.textContent || 'إرسال الرسالة';
        if (submitButton) { submitButton.disabled = true; submitButton.textContent = 'جارٍ الإرسال...'; }
        formStatus.className = 'form-status is-pending';
        formStatus.textContent = 'يتم إرسال رسالتك الآن...';
        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'Accept': 'application/json' },
            body: new URLSearchParams(new FormData(contactForm)).toString()
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || 'تعذر إرسال الرسالة.');
          contactForm.reset();
          formStatus.className = 'form-status is-success';
          formStatus.textContent = data.message || 'تم استلام رسالتك بنجاح.';
        } catch (error) {
          formStatus.className = 'form-status is-error';
          formStatus.textContent = error?.message || 'تعذر إرسال الرسالة حاليًا. يرجى المحاولة مرة أخرى.';
        } finally {
          if (submitButton) { submitButton.disabled = false; submitButton.textContent = originalLabel; }
        }
      });
    })();
  </script>
</BaseLayout>
