---
const { meta } = Astro.props;
const isNotFound = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/" || Astro.url.pathname.endsWith("/404.html");

// تنظيف الدومين
const baseUrl = (meta.url || "").replace(/\/+$/, "");

// canonical حسب المسار
const canonical = `${baseUrl}${Astro.url.pathname}`;

const ogImageAbs = meta.ogImage?.startsWith("http")
  ? meta.ogImage
  : `${baseUrl}${meta.ogImage?.startsWith("/") ? "" : "/"}${meta.ogImage || ""}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {isNotFound && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.ico" sizes="any">


    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content={meta.locale || "ar_SA"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.title} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={meta.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Official Hedayaat typography is self-hosted in /fonts. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');

        // The homepage must ALWAYS open on the hero. iOS/WhatsApp in-app browsers
        // can restore an old anchor/scroll position before the page finishes loading.
        const isHome = window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');
        if (!isHome) return;

        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

        // Remove a stale #contact/#about fragment before the matching section exists,
        // preventing the browser from auto-jumping there on first render.
        if (window.location.hash) {
          history.replaceState(history.state, '', window.location.pathname + window.location.search);
        }

        document.documentElement.style.scrollBehavior = 'auto';
        document.documentElement.scrollTop = 0;
        window.scrollTo(0, 0);
      })();
    </script>

    <link rel="stylesheet" href="/styles/site.css?v=20260912-footer-404-whatsapp-v16" />
  </head>

  <body>
    <slot />

    <script is:inline>
      (() => {
        const isHome = window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');
        if (!isHome) return;

        let userInteracted = false;
        const markInteraction = () => { userInteracted = true; };
        ['touchstart', 'pointerdown', 'mousedown', 'keydown', 'wheel'].forEach((eventName) => {
          window.addEventListener(eventName, markInteraction, { passive: true, once: true });
        });

        const removeStaleHash = () => {
          if (window.location.hash) {
            history.replaceState(history.state, '', window.location.pathname + window.location.search);
          }
        };

        const resetToHero = () => {
          if (userInteracted) return;
          removeStaleHash();
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
          const hero = document.getElementById('home');
          if (hero && window.scrollY > 2) hero.scrollIntoView({ block: 'start', behavior: 'auto' });
        };

        const runRecoveryPasses = () => {
          resetToHero();
          requestAnimationFrame(() => requestAnimationFrame(resetToHero));
          [40, 120, 300, 700, 1400].forEach((delay) => setTimeout(resetToHero, delay));
        };

        document.addEventListener('DOMContentLoaded', runRecoveryPasses, { once: true });
        window.addEventListener('load', runRecoveryPasses, { once: true });
        window.addEventListener('pageshow', () => {
          // pageshow also fires when iOS restores the tab from its back/forward cache.
          userInteracted = false;
          runRecoveryPasses();
        });

        // Stop forcing the top after the browser has had time to finish restoration.
        setTimeout(() => {
          document.documentElement.style.scrollBehavior = '';
        }, 1700);
      })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
