---
const { meta } = Astro.props;
const isNotFound = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/" || Astro.url.pathname.endsWith("/404.html");

// تنظيف الدومين
const baseUrl = (meta.url || "").replace(/\/+$/, "");

// canonical حسب المسار
const canonical = `${baseUrl}${Astro.url.pathname}`;

const ogImageAbs = meta.ogImage?.startsWith("http")
  ? meta.ogImage
  : `${baseUrl}${meta.ogImage?.startsWith("/") ? "" : "/"}${meta.ogImage || ""}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {isNotFound && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any">


    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content={meta.locale || "ar_SA"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.siteName || "مؤسسة هدايات التعليمية"} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={meta.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Core UI assets are self-hosted so navigation/layout keep working even if an external CDN is unavailable. -->
    <link rel="stylesheet" href="/vendor/bootstrap.min.css?v=536" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons.min.css?v=local" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');

        const isHome = window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');
        if (!isHome) return;

        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

        // نحافظ على الروابط المقصودة مثل /#contact و /#about.
        // فقط إذا لم يوجد hash نمنع المتصفح من استعادة موضع تمرير قديم.
        if (!window.location.hash) {
          document.documentElement.style.scrollBehavior = 'auto';
          document.documentElement.scrollTop = 0;
          window.scrollTo(0, 0);
        }
      })();
    </script>

    <link rel="stylesheet" href="/styles/site.css?v=28" />
  </head>

  <body>
    <slot />

    <script is:inline>
      (() => {
        const isHome = window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');
        if (!isHome) return;

        let userInteracted = false;
        const markInteraction = () => { userInteracted = true; };
        ['touchstart', 'pointerdown', 'mousedown', 'keydown', 'wheel'].forEach((eventName) => {
          window.addEventListener(eventName, markInteraction, { passive: true, once: true });
        });

        const applyInitialPosition = () => {
          const hash = window.location.hash;
          if (hash) {
            let id = hash.slice(1);
            try { id = decodeURIComponent(id); } catch { /* keep the raw fragment if it is malformed */ }
            const target = document.getElementById(id);
            if (target) target.scrollIntoView({ block: 'start', behavior: 'auto' });
            return;
          }
          if (userInteracted) return;
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        };

        const runPositionPasses = () => {
          applyInitialPosition();
          requestAnimationFrame(() => requestAnimationFrame(applyInitialPosition));
          [80, 250, 700].forEach((delay) => setTimeout(applyInitialPosition, delay));
        };

        document.addEventListener('DOMContentLoaded', runPositionPasses, { once: true });
        window.addEventListener('load', runPositionPasses, { once: true });
        window.addEventListener('pageshow', () => {
          userInteracted = false;
          runPositionPasses();
        });

        setTimeout(() => { document.documentElement.style.scrollBehavior = ''; }, 900);
      })();
    </script>

    <script src="/vendor/bootstrap.bundle.min.js?v=536"></script>
  </body>
</html>
