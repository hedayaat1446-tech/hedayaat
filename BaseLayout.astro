---
const { meta } = Astro.props;

const configuredUrl = String(meta?.url || '').trim();
const hasOfficialUrl = /^https?:\/\//i.test(configuredUrl) && !/YOUR[-_]/i.test(configuredUrl);
const baseUrl = hasOfficialUrl ? configuredUrl.replace(/\/+$/, '') : null;
const canonical = baseUrl ? new URL(Astro.url.pathname, `${baseUrl}/`).toString() : null;
const ogImageAbs = baseUrl && meta?.ogImage
  ? new URL(meta.ogImage, `${baseUrl}/`).toString()
  : null;

const organizationSchema = baseUrl ? {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: meta?.title || 'مؤسسة هدايات التعليمية',
  url: baseUrl,
  logo: new URL('/1.png', `${baseUrl}/`).toString(),
  description: meta?.description || undefined,
} : null;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1712" />
    <meta name="color-scheme" content="light" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:locale" content={meta.locale || 'ar_SA'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.title} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    {ogImageAbs && <meta property="og:image:alt" content={meta.title} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    {organizationSchema && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="stylesheet" href="/styles/site.css" />
  </head>

  <body>
    <slot />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
