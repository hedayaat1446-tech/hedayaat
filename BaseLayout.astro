---
const { meta, lang = "ar", dir = lang === "ar" ? "rtl" : "ltr", skipLabel = lang === "ar" ? "تجاوز إلى المحتوى الرئيسي" : "Skip to main content", accessibilityLabel = lang === "ar" ? "أدوات إمكانية الوصول" : "Accessibility tools" } = Astro.props;
const isNotFound = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/" || Astro.url.pathname.endsWith("/404.html");

// تنظيف الدومين
const baseUrl = (meta.url || "").replace(/\/+$/, "");

// canonical حسب المسار
const canonical = `${baseUrl}${Astro.url.pathname}`;

const localePairs = {
  "/": "/en/",
  "/board/": "/en/board/",
  "/governance/": "/en/governance/",
  "/transparency/": "/en/transparency/",
  "/accessibility/": "/en/accessibility/",
  "/privacy/": "/en/privacy/",
  "/reports/": "/en/reports/",
  "/news/": "/en/news/",
  "/photos/": "/en/photos/",
  "/videos/": "/en/videos/",
  "/participation/": "/en/participation/",
  "/thank/": "/en/thank/"
};
const reverseLocalePairs = Object.fromEntries(Object.entries(localePairs).map(([ar, en]) => [en, ar]));
const currentPath = Astro.url.pathname.endsWith("/") || Astro.url.pathname.includes(".")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const arPath = currentPath.startsWith("/en/") ? (reverseLocalePairs[currentPath] || "/") : currentPath;
const enPath = currentPath.startsWith("/en/") ? currentPath : (localePairs[currentPath] || "/en/");
const alternateAr = `${baseUrl}${arPath}`;
const alternateEn = `${baseUrl}${enPath}`;

const ogImageAbs = meta.ogImage?.startsWith("http")
  ? meta.ogImage
  : `${baseUrl}${meta.ogImage?.startsWith("/") ? "" : "/"}${meta.ogImage || ""}`;

const feedback = lang === "ar" ? {
  launcher: "شاركنا رأيك",
  title: "رأيك يهمنا",
  subtitle: "هل كانت هذه الصفحة مفيدة؟",
  yes: "نعم",
  somewhat: "إلى حد ما",
  no: "لا",
  commentLabel: "ملاحظة أو اقتراح (اختياري)",
  commentPlaceholder: "اكتبي ملاحظتك باختصار...",
  privacy: "لا نطلب أي بيانات شخصية في هذا التقييم.",
  submit: "إرسال الرأي",
  sending: "جارٍ الإرسال...",
  close: "إغلاق نافذة التقييم",
  choose: "اختاري أحد الخيارات أولًا.",
  failed: "تعذر إرسال رأيك الآن. حاولي مرة أخرى.",
  thanks: "شكرًا لك. تم تسجيل رأيك.",
  center: "مركز مشاركة المستفيد وقياس الرضا"
} : {
  launcher: "Share feedback",
  title: "Your feedback matters",
  subtitle: "Was this page helpful?",
  yes: "Yes",
  somewhat: "Somewhat",
  no: "No",
  commentLabel: "Comment or suggestion (optional)",
  commentPlaceholder: "Share a brief note...",
  privacy: "We do not ask for personal information in this feedback form.",
  submit: "Send feedback",
  sending: "Sending...",
  close: "Close feedback dialog",
  choose: "Please choose one option first.",
  failed: "We could not send your feedback right now. Please try again.",
  thanks: "Thank you. Your feedback has been recorded.",
  center: "Beneficiary Participation & Satisfaction"
};
// ===== Shared site chrome (header + breadcrumb + footer) for every inner page =====
import siteAr from "../content/site.json";
import siteEn from "../content/site-en.json";
const { chrome } = Astro.props;
const normPath = (p) => {
  let x = (p || "/").split("?")[0].split("#")[0];
  if (x.endsWith("/index.html")) x = x.slice(0, -10);
  if (x.endsWith(".html")) x = x.slice(0, -5) + "/";
  if (!x.endsWith("/")) x += "/";
  return x;
};
const here = normPath(Astro.url.pathname);
const isHomePage = here === "/" || here === "/en/";
const showChrome = chrome ?? true;
const isAr = lang === "ar";
const chromeSite = isAr ? siteAr : siteEn;
const homeHref = isAr ? "/" : "/en/";
const fixHref = (h) => (h && h.startsWith("#") ? `${homeHref}${h}` : h);
const navItems = isAr
  ? siteAr.nav.filter((i) => i.enabled !== false).map((i) => ({ ...i, href: fixHref(i.href), children: i.children?.map((c) => ({ ...c, href: fixHref(c.href) })) }))
  : [
      { label: "About the Foundation", children: [
        { label: "Who we are", href: "/en/#about" }, { label: "Strategic Goals", href: "/en/#goals" },
        { label: "Our Values", href: "/en/#values" }, { label: "Organizational Management", href: "/en/board/" } ] },
      { label: "Programs & Partnerships", href: "/en/#programs" },
      { label: "Governance", children: [
        { label: "Governance Center", href: "/en/governance/" }, { label: "Transparency & Disclosure", href: "/en/transparency/" },
        { label: "Financial Reports", href: "/en/reports/" } ] },
      { label: "Media Center", href: "/en/videos/" },
      { label: "Beneficiary Participation", href: "/en/participation/" },
      { label: "Contact Us", href: "/en/#contact", cta: true },
      { label: "Arabic", href: "/" }
    ];
const isCurrent = (h) => !!h && !h.includes("#") && normPath(h) === here && h !== homeHref;
const crumbMap = {
  "/board/": [["عن المؤسسة", "/#about"], ["الإدارة التنظيمية"]],
  "/governance/": [["الحوكمة"], ["مركز الحوكمة"]],
  "/transparency/": [["الحوكمة", "/governance/"], ["الشفافية والإفصاح"]],
  "/reports/": [["الحوكمة", "/governance/"], ["القوائم والتقارير المالية"]],
  "/videos/": [["المركز الإعلامي"], ["الفيديو"]],
  "/news/": [["المركز الإعلامي"], ["آخر الأخبار"]],
  "/photos/": [["المركز الإعلامي"], ["الصور"]],
  "/participation/": [["مشاركة المستفيد"]],
  "/privacy/": [["سياسة الخصوصية"]],
  "/accessibility/": [["بيان إمكانية الوصول"]],
  "/thank/": [["تواصل معنا", "/#contact"], ["تم استلام رسالتك"]],
  "/en/board/": [["About the Foundation", "/en/#about"], ["Organizational Management"]],
  "/en/governance/": [["Governance"], ["Governance Center"]],
  "/en/transparency/": [["Governance", "/en/governance/"], ["Transparency & Disclosure"]],
  "/en/reports/": [["Governance", "/en/governance/"], ["Financial Reports"]],
  "/en/videos/": [["Media Center"], ["Video"]],
  "/en/news/": [["Media Center"], ["News"]],
  "/en/photos/": [["Media Center"], ["Photos"]],
  "/en/participation/": [["Beneficiary Participation"]],
  "/en/privacy/": [["Privacy Policy"]],
  "/en/accessibility/": [["Accessibility Statement"]],
  "/en/thank/": [["Contact", "/en/#contact"], ["Message received"]]
};
const crumbs = crumbMap[here] || (isNotFound ? [[isAr ? "الصفحة غير موجودة" : "Page not found"]] : null);
const waDigitsChrome = String(chromeSite.contact?.phone || siteAr.contact?.phone || "").replace(/\D/g, "");
const waLinkChrome = `https://wa.me/${waDigitsChrome}`;
const licenseNo = siteAr.institution?.licenseNumber || "";
const inst = siteAr.institution || {};
const contactInfo = siteAr.contact || {};
const menuItems = navItems.filter((i) => !i.cta && i.href !== "/" && i.href !== "/en/");
const ctaItem = navItems.find((i) => i.cta) || { label: isAr ? "تواصل معنا" : "Contact Us", href: `${homeHref}#contact` };
const bodyClass = isHomePage ? "home-page" : "inner-page";
const buildDate = new Date();
const lastUpdated = isAr
  ? new Intl.DateTimeFormat("ar-SA-u-nu-latn-ca-gregory", { day: "numeric", month: "long", year: "numeric" }).format(buildDate)
  : new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(buildDate);
const T = isAr ? {
  search: "بحث في الموقع", searchPh: "ابحث في الصفحات والوثائق والسياسات…", searchHint: "اكتب كلمتين أو أكثر، مثل: الترخيص، الخصوصية، مجلس الأمناء",
  noResults: "لا توجد نتائج مطابقة. جرّب كلمة أخرى.", close: "إغلاق", dark: "الوضع الليلي", light: "الوضع النهاري",
  a11y: "أدوات إمكانية الوصول", smaller: "A− تصغير النص", reset: "A الحجم الافتراضي", larger: "A+ تكبير النص", contrast: "تباين عالٍ",
  feedback: "شاركنا رأيك", top: "العودة إلى أعلى الصفحة", whatsapp: "تواصل عبر واتساب", menu: "فتح القائمة",
  tabHome: "الرئيسية", tabGov: "الحوكمة", tabPart: "المشاركة", tabContact: "تواصل",
  fAbout: "عن المؤسسة", fGov: "الحوكمة", fServices: "الخدمات", fContact: "تواصل معنا",
  blurb: "مؤسسة تعليمية أهلية مرخّصة تحت إشراف وزارة التعليم، تُعنى ببناء الوعي وتعزيز القيم.",
  type: "صفة المؤسسة", license: "رقم الترخيص", unified: "الرقم الوطني الموحد", supervision: "جهة الإشراف", verify: "التحقق من الترخيص",
  updated: "آخر تحديث للموقع", viewer: "عارض الوثائق", download: "تحميل PDF", newTab: "فتح في نافذة جديدة", doc: "وثيقة"
} : {
  search: "Search the site", searchPh: "Search pages, documents and policies…", searchHint: "Try words such as: license, privacy, board of trustees",
  noResults: "No matching results. Try another word.", close: "Close", dark: "Dark mode", light: "Light mode",
  a11y: "Accessibility tools", smaller: "A− Decrease text size", reset: "A Default text size", larger: "A+ Increase text size", contrast: "High contrast",
  feedback: "Share feedback", top: "Back to top", whatsapp: "Contact us on WhatsApp", menu: "Open menu",
  tabHome: "Home", tabGov: "Governance", tabPart: "Participate", tabContact: "Contact",
  fAbout: "About", fGov: "Governance", fServices: "Services", fContact: "Contact Us",
  blurb: "A licensed non-profit educational foundation under the supervision of the Ministry of Education, dedicated to building awareness and strengthening values.",
  type: "Organization type", license: "License No.", unified: "Unified National No.", supervision: "Supervising authority", verify: "Verify license",
  updated: "Site last updated", viewer: "Document viewer", download: "Download PDF", newTab: "Open in new tab", doc: "Document"
};
const p = (ar, en) => (isAr ? ar : en);
const footerCols = [
  { title: T.fAbout, links: [[p("من نحن","Who We Are"), `${homeHref}#about`], [p("الأهداف الاستراتيجية","Strategic Goals"), `${homeHref}#goals`], [p("قيمنا","Our Values"), `${homeHref}#values`], [p("الإدارة التنظيمية","Organizational Management"), p("/board/","/en/board/")], [p("البرامج والشراكات","Programs & Partnerships"), `${homeHref}#programs`]] },
  { title: T.fGov, links: [[p("مركز الحوكمة","Governance Center"), p("/governance/","/en/governance/")], [p("الشفافية والإفصاح","Transparency & Disclosure"), p("/transparency/","/en/transparency/")], [p("القوائم والتقارير المالية","Financial Reports"), p("/reports/","/en/reports/")], [p("سياسة الخصوصية","Privacy Policy"), p("/privacy/","/en/privacy/")]] },
  { title: T.fServices, links: [[p("مشاركة المستفيد","Beneficiary Participation"), p("/participation/","/en/participation/")], [p("متابعة طلب","Track a Request"), p("/participation/#track","/en/participation/#track")], [p("المركز الإعلامي","Media Center"), p("/videos/","/en/videos/")], [p("بيان إمكانية الوصول","Accessibility Statement"), p("/accessibility/","/en/accessibility/")]] }
];
const socials = (contactInfo.social || []).filter((x) => x.url);

---

<!doctype html>
<html lang={lang} dir={dir} data-site-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {isNotFound && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any">


    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={alternateAr} />
    <link rel="alternate" hreflang="en" href={alternateEn} />

    <!-- Open Graph -->
    <meta property="og:locale" content={meta.locale || "ar_SA"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.siteName || "مؤسسة هدايات التعليمية"} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={meta.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Core UI assets are self-hosted so navigation/layout keep working even if an external CDN is unavailable. -->
    <script is:inline>
      // Automatic, continuous scaling: the layout is designed for ~1366px wide. On wider screens the whole
      // interface grows in exact proportion to the screen width (live on resize). Phones/tablets/laptops keep
      // their own responsive layout (scale 1). The CSS steps in site.css remain as a fallback without JS.
      (() => {
        // Phones (portrait, under 600px) are scaled the same way around a 390px design width, so the page
        // fills small and large phones alike (between 88% and 112%); tablets and laptops keep scale 1.
        const BASE = 1366, MAX = 3.2, PHONE = 390, PMIN = 0.88, PMAX = 1.12, root = document.documentElement;
        const fit = () => {
          const w = window.innerWidth || root.clientWidth;
          const h = window.innerHeight || root.clientHeight;
          let z = 1;
          if (w > BASE) z = Math.min(w / BASE, MAX);
          else if (w < 600 && h >= w) z = Math.min(Math.max(w / PHONE, PMIN), PMAX);
          if (Math.abs(z - 1) < 0.015) z = 1;
          root.style.zoom = z === 1 ? '' : z.toFixed(4);
          root.style.setProperty('--auto-zoom', z);
        };
        fit();
        let t; const refit = () => { cancelAnimationFrame(t); t = requestAnimationFrame(fit); };
        window.addEventListener('resize', refit, { passive: true });
        window.addEventListener('orientationchange', refit, { passive: true });
      })();
    </script>

    <script is:inline>
      // Apply the saved light/dark preference before the page paints (no flash).
      try { if (localStorage.getItem('hedayat-theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch {}
    </script>
    <link rel="manifest" href={isAr ? "/manifest.webmanifest" : "/manifest-en.webmanifest"} />
    <meta name="theme-color" content="#16404F" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={isAr ? "هدايات" : "Hedayat"} />

    <link rel="stylesheet" href="/vendor/bootstrap.min.css?v=536" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons.min.css?v=local" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');

        const path = window.location.pathname;
        const isHome = path === '/' || path === '/en/' || path.endsWith('/index.html');
        if (!isHome) return;

        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

        // نحافظ على الروابط المقصودة مثل /#contact و /#about.
        // فقط إذا لم يوجد hash نمنع المتصفح من استعادة موضع تمرير قديم.
        if (!window.location.hash) {
          document.documentElement.style.scrollBehavior = 'auto';
          document.documentElement.scrollTop = 0;
          window.scrollTo(0, 0);
        }
      })();
    </script>

    <script is:inline>
      (() => {
        const html = document.documentElement;
        const currentLang = html.dataset.siteLang === 'en' ? 'en' : 'ar';

        const arToEn = {
          '/': '/en/',
          '/board/': '/en/board/',
          '/governance/': '/en/governance/',
          '/transparency/': '/en/transparency/',
          '/accessibility/': '/en/accessibility/',
          '/privacy/': '/en/privacy/',
          '/reports/': '/en/reports/',
          '/news/': '/en/news/',
          '/photos/': '/en/photos/',
          '/videos/': '/en/videos/',
          '/participation/': '/en/participation/',
          '/thank/': '/en/thank/'
        };
        const enToAr = Object.fromEntries(
          Object.entries(arToEn).map(([ar, en]) => [en, ar])
        );

        const normalize = (value) => {
          if (!value) return '/';
          let path = value.split('?')[0].split('#')[0] || '/';
          if (path === '/index.html') return '/';
          if (path === '/en/index.html') return '/en/';
          if (!path.endsWith('/') && !path.includes('.')) path += '/';
          return path;
        };

        const languageTarget = (path, lang) => {
          const normalized = normalize(path);
          if (lang === 'en') {
            return arToEn[normalized] || (normalized.startsWith('/en/') ? normalized : null);
          }
          return enToAr[normalized] || (!normalized.startsWith('/en/') ? normalized : null);
        };

        // The URL alone decides the language: /en/... is always English, everything else is always Arabic.
        // (A previous version remembered the last choice in localStorage and force-redirected every page to it,
        // which made it impossible to open the other language and caused pages to "bounce" between languages.)
        try { localStorage.removeItem('hedayat-language'); } catch {}

        document.addEventListener('click', (event) => {
          const link = event.target.closest('a[href]');
          if (!link) return;

          const requested = link.dataset.languageSwitch;
          if (requested === 'ar' || requested === 'en') {
            const target = languageTarget(link.pathname, requested) || (requested === 'en' ? '/en/' : '/');
            const hash = link.hash || (link.hasAttribute('data-keep-hash') ? location.hash : '');
            link.href = target + (link.search || '') + hash;
            return;
          }

          // Keep all internal navigation in the language currently being viewed.
          // This also protects against an accidental Arabic URL inside an English page (and vice versa).
          if (link.origin !== location.origin) return;
          const target = languageTarget(link.pathname, currentLang);
          if (!target || target === normalize(link.pathname)) return;

          link.href = target + (link.search || '') + (link.hash || '');
        }, true);
      })();
    </script>

    <link rel="stylesheet" href="/styles/site.css?v=61" />
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{skipLabel}</a>

    {showChrome && (
      <>
        <nav class="navbar navbar-expand-lg fixed-top hdr site-chrome-hdr" aria-label={isAr ? "القائمة الرئيسية" : "Primary navigation"}>
          <div class="container align-items-center hdr-inner">
            <a class="navbar-brand hdr-brand" href={homeHref}>
              <img src={chromeSite.assets?.logoNav || "/hedayat-logo-gold.png"} alt={isAr ? "شعار مؤسسة هدايات التعليمية" : "Hedayat Educational Foundation logo"} class="official-logo official-logo-nav" width="900" height="337" />
              {!isAr && <span class="brand-en-name" aria-hidden="true"><strong>Hedayat</strong><span>Educational Foundation</span></span>}
              <span class="visually-hidden">{isAr ? "الصفحة الرئيسية" : "Home page"}</span>
            </a>
            <div class="hdr-mobile-actions d-flex d-lg-none">
              <button class="hdr-icon-btn" type="button" data-search-open aria-label={T.search} title={T.search}><i class="bi bi-search" aria-hidden="true"></i></button>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navChrome" aria-controls="navChrome" aria-expanded="false" aria-label={T.menu}><span class="navbar-toggler-icon"></span></button>
            </div>
            <div class="collapse navbar-collapse" id="navChrome">
              <ul class="navbar-nav nav-rtl mx-auto gap-lg-1">
                {menuItems.map((item) => item.children?.length ? (
                  <li class={`nav-item dropdown hedayat-nav-group${item.children.some((c) => isCurrent(c.href)) ? " is-current" : ""}`}>
                    <button class="nav-link dropdown-toggle nav-dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" aria-expanded="false">{item.label}</button>
                    <ul class="dropdown-menu hedayat-dropdown">
                      {item.children.map((c) => (<li><a class={`dropdown-item${isCurrent(c.href) ? " active" : ""}`} href={c.href} aria-current={isCurrent(c.href) ? "page" : undefined}>{c.label}</a></li>))}
                    </ul>
                  </li>
                ) : (
                  <li class="nav-item"><a class={`nav-link${isCurrent(item.href) ? " active" : ""}`} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
                ))}
              </ul>
              <div class="hdr-actions">
                <button class="hdr-icon-btn d-none d-lg-inline-flex" type="button" data-search-open aria-label={T.search} title={T.search}><i class="bi bi-search" aria-hidden="true"></i></button>
                <button class="hdr-icon-btn" type="button" data-theme-toggle aria-pressed="false" aria-label={T.dark} title={T.dark} data-label-dark={T.dark} data-label-light={T.light}><i class="bi bi-moon-stars" aria-hidden="true"></i><span class="d-lg-none">{T.dark}</span></button>
                <a class="hdr-icon-btn hdr-whatsapp" href={waLinkChrome} target="_blank" rel="noopener" aria-label={T.whatsapp} title={T.whatsapp}><i class="bi bi-whatsapp" aria-hidden="true"></i><span class="d-lg-none">{isAr ? "واتساب" : "WhatsApp"}</span></a>
                <a class="hdr-lang" href={isAr ? enPath : arPath} lang={isAr ? "en" : "ar"} dir={isAr ? "ltr" : "rtl"} hreflang={isAr ? "en" : "ar"} data-language-switch={isAr ? "en" : "ar"} data-keep-hash>{isAr ? "English" : "العربية"}</a>
                <a class="hdr-cta" href={ctaItem.href}>{ctaItem.label}</a>
              </div>
            </div>
          </div>
        </nav>
        <div class="brand-ribbon" role="presentation" aria-hidden="true"></div>
        {!isHomePage && crumbs && (
          <nav class="crumbs" aria-label={isAr ? "مسار الصفحة" : "Breadcrumb"}>
            <ol>
              <li><a href={homeHref}><i class="bi bi-house-door" aria-hidden="true"></i> {isAr ? "الرئيسية" : "Home"}</a></li>
              {crumbs.map(([label, href], i) => (
                <li>
                  <span class="crumb-sep" aria-hidden="true">{isAr ? "‹" : "›"}</span>
                  {i === crumbs.length - 1
                    ? <span aria-current="page">{label}</span>
                    : href ? <a href={href}>{label}</a> : <span>{label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
      </>
    )}

    <slot />

    {showChrome && (
