---
const { meta, lang = "ar", dir = lang === "ar" ? "rtl" : "ltr", skipLabel = lang === "ar" ? "تجاوز إلى المحتوى الرئيسي" : "Skip to main content", accessibilityLabel = lang === "ar" ? "أدوات إمكانية الوصول" : "Accessibility tools" } = Astro.props;
const isNotFound = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/" || Astro.url.pathname.endsWith("/404.html");

// تنظيف الدومين
const baseUrl = (meta.url || "").replace(/\/+$/, "");

// canonical حسب المسار
const canonical = `${baseUrl}${Astro.url.pathname}`;

const ogImageAbs = meta.ogImage?.startsWith("http")
  ? meta.ogImage
  : `${baseUrl}${meta.ogImage?.startsWith("/") ? "" : "/"}${meta.ogImage || ""}`;

const feedback = lang === "ar" ? {
  launcher: "شاركنا رأيك",
  title: "رأيك يهمنا",
  subtitle: "هل كانت هذه الصفحة مفيدة؟",
  yes: "نعم",
  somewhat: "إلى حد ما",
  no: "لا",
  commentLabel: "ملاحظة أو اقتراح (اختياري)",
  commentPlaceholder: "اكتبي ملاحظتك باختصار...",
  privacy: "لا نطلب أي بيانات شخصية في هذا التقييم.",
  submit: "إرسال الرأي",
  sending: "جارٍ الإرسال...",
  close: "إغلاق نافذة التقييم",
  choose: "اختاري أحد الخيارات أولًا.",
  failed: "تعذر إرسال رأيك الآن. حاولي مرة أخرى.",
  thanks: "شكرًا لك. تم تسجيل رأيك.",
  center: "مركز مشاركة المستفيد وقياس الرضا"
} : {
  launcher: "Share feedback",
  title: "Your feedback matters",
  subtitle: "Was this page helpful?",
  yes: "Yes",
  somewhat: "Somewhat",
  no: "No",
  commentLabel: "Comment or suggestion (optional)",
  commentPlaceholder: "Share a brief note...",
  privacy: "We do not ask for personal information in this feedback form.",
  submit: "Send feedback",
  sending: "Sending...",
  close: "Close feedback dialog",
  choose: "Please choose one option first.",
  failed: "We could not send your feedback right now. Please try again.",
  thanks: "Thank you. Your feedback has been recorded.",
  center: "Beneficiary Participation & Satisfaction"
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {isNotFound && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any">


    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:locale" content={meta.locale || "ar_SA"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.siteName || "مؤسسة هدايات التعليمية"} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={meta.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Core UI assets are self-hosted so navigation/layout keep working even if an external CDN is unavailable. -->
    <link rel="stylesheet" href="/vendor/bootstrap.min.css?v=536" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons.min.css?v=local" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');

        const path = window.location.pathname;
        const isHome = path === '/' || path === '/en/' || path.endsWith('/index.html');
        if (!isHome) return;

        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

        // نحافظ على الروابط المقصودة مثل /#contact و /#about.
        // فقط إذا لم يوجد hash نمنع المتصفح من استعادة موضع تمرير قديم.
        if (!window.location.hash) {
          document.documentElement.style.scrollBehavior = 'auto';
          document.documentElement.scrollTop = 0;
          window.scrollTo(0, 0);
        }
      })();
    </script>

    <link rel="stylesheet" href="/styles/site.css?v=30" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>

    <aside class="a11y-tools" aria-label={accessibilityLabel}>
      <button type="button" data-a11y="decrease" aria-label={lang === "ar" ? "تصغير حجم النص" : "Decrease text size"} title={lang === "ar" ? "تصغير النص" : "Decrease text"}>A−</button>
      <button type="button" data-a11y="reset" aria-label={lang === "ar" ? "إعادة حجم النص للوضع الافتراضي" : "Reset text size"} title={lang === "ar" ? "الحجم الافتراضي" : "Default size"}>A</button>
      <button type="button" data-a11y="increase" aria-label={lang === "ar" ? "تكبير حجم النص" : "Increase text size"} title={lang === "ar" ? "تكبير النص" : "Increase text"}>A+</button>
      <button type="button" data-a11y="contrast" aria-pressed="false" aria-label={lang === "ar" ? "تفعيل التباين العالي" : "Toggle high contrast"} title={lang === "ar" ? "تباين عالٍ" : "High contrast"}><i class="bi bi-circle-half" aria-hidden="true"></i></button>
    </aside>

    <slot />

    {!isNotFound && (
      <div class="page-feedback" data-feedback-root data-lang={lang} data-sending={feedback.sending} data-choose={feedback.choose} data-failed={feedback.failed} data-thanks={feedback.thanks}>
        <button class="feedback-launcher" type="button" data-feedback-open aria-haspopup="dialog" aria-controls="feedbackDialog">
          <i class="bi bi-chat-dots" aria-hidden="true"></i>
          <span>{feedback.launcher}</span>
        </button>

        <dialog id="feedbackDialog" class="feedback-dialog" aria-labelledby="feedbackTitle" aria-describedby="feedbackSubtitle">
          <form class="feedback-form" data-feedback-form novalidate>
            <div class="feedback-head">
              <div>
                <h2 id="feedbackTitle">{feedback.title}</h2>
                <p id="feedbackSubtitle">{feedback.subtitle}</p>
              </div>
              <button class="feedback-close" type="button" data-feedback-close aria-label={feedback.close} title={feedback.close}>×</button>
            </div>

            <fieldset class="feedback-choices">
              <legend class="visually-hidden">{feedback.subtitle}</legend>
              <label><input type="radio" name="choice" value="yes" /><span><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i>{feedback.yes}</span></label>
              <label><input type="radio" name="choice" value="somewhat" /><span><i class="bi bi-dash-circle" aria-hidden="true"></i>{feedback.somewhat}</span></label>
              <label><input type="radio" name="choice" value="no" /><span><i class="bi bi-hand-thumbs-down" aria-hidden="true"></i>{feedback.no}</span></label>
            </fieldset>

            <label class="feedback-comment-label" for="feedbackComment">{feedback.commentLabel}</label>
            <textarea id="feedbackComment" name="comment" maxlength="1200" rows="4" placeholder={feedback.commentPlaceholder}></textarea>
            <input class="feedback-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="feedback-privacy"><i class="bi bi-shield-check" aria-hidden="true"></i>{feedback.privacy}</p>
            <a class="feedback-center-link" href={lang === "ar" ? "/participation/" : "/en/participation/"}><i class="bi bi-people" aria-hidden="true"></i>{feedback.center}</a>
            <div class="feedback-actions">
              <button class="feedback-submit" type="submit">{feedback.submit}</button>
              <div class="feedback-status" data-feedback-status role="status" aria-live="polite"></div>
            </div>
          </form>
        </dialog>
      </div>
    )}

    {!isNotFound && (
      <script is:inline>
        (() => {
          const root = document.querySelector('[data-feedback-root]');
          if (!root) return;
          const feedbackLang = root.dataset.lang === 'en' ? 'en' : 'ar';
          const feedbackSending = root.dataset.sending || '';
          const feedbackChoose = root.dataset.choose || '';
          const feedbackFailed = root.dataset.failed || '';
          const feedbackThanks = root.dataset.thanks || '';
          const dialog = root.querySelector('.feedback-dialog');
          const openButton = root.querySelector('[data-feedback-open]');
          const closeButton = root.querySelector('[data-feedback-close]');
          const form = root.querySelector('[data-feedback-form]');
          const status = root.querySelector('[data-feedback-status]');
          const submitButton = root.querySelector('.feedback-submit');

          const setStatus = (message, type = '') => {
            status.textContent = message || '';
            status.dataset.state = type;
          };

          const openDialog = () => {
            setStatus('');
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', '');
          };
          const closeDialog = () => {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          };

          openButton.addEventListener('click', openDialog);
          closeButton.addEventListener('click', closeDialog);
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const inside = event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom;
            if (!inside) closeDialog();
          });

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const choice = String(data.get('choice') || '');
            if (!choice) {
              setStatus(feedbackChoose, 'error');
              form.querySelector('input[name="choice"]')?.focus();
              return;
            }

            submitButton.disabled = true;
            setStatus(feedbackSending, 'loading');
            try {
              const response = await fetch('/api/feedback', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                  choice,
                  comment: String(data.get('comment') || ''),
                  'bot-field': String(data.get('bot-field') || ''),
                  lang: feedbackLang,
                  page: window.location.pathname
                })
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok) throw new Error(payload.message || feedbackFailed);
              form.reset();
              setStatus(payload.message || feedbackThanks, 'success');
              openButton.classList.add('feedback-sent');
              setTimeout(closeDialog, 1400);
            } catch (error) {
              setStatus(error?.message || feedbackFailed, 'error');
            } finally {
              submitButton.disabled = false;
            }
          });
        })();
      </script>
    )}

    <script is:inline>
      (() => {
        const path = window.location.pathname;
        const isHome = path === '/' || path === '/en/' || path.endsWith('/index.html');
        if (!isHome) return;

        let userInteracted = false;
        const markInteraction = () => { userInteracted = true; };
        ['touchstart', 'pointerdown', 'mousedown', 'keydown', 'wheel'].forEach((eventName) => {
          window.addEventListener(eventName, markInteraction, { passive: true, once: true });
        });

        const applyInitialPosition = () => {
          const hash = window.location.hash;
          if (hash) {
            let id = hash.slice(1);
            try { id = decodeURIComponent(id); } catch { /* keep the raw fragment if it is malformed */ }
            const target = document.getElementById(id);
            if (target) target.scrollIntoView({ block: 'start', behavior: 'auto' });
            return;
          }
          if (userInteracted) return;
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        };

        const runPositionPasses = () => {
          applyInitialPosition();
          requestAnimationFrame(() => requestAnimationFrame(applyInitialPosition));
          [80, 250, 700].forEach((delay) => setTimeout(applyInitialPosition, delay));
        };

        document.addEventListener('DOMContentLoaded', runPositionPasses, { once: true });
        window.addEventListener('load', runPositionPasses, { once: true });
        window.addEventListener('pageshow', () => {
          userInteracted = false;
          runPositionPasses();
        });

        setTimeout(() => { document.documentElement.style.scrollBehavior = ''; }, 900);
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const scaleKey = 'hedayat-font-scale';
        const contrastKey = 'hedayat-high-contrast';
        const allowedScales = [0.9, 1, 1.125, 1.25];

        const readScale = () => {
          const value = Number(localStorage.getItem(scaleKey) || '1');
          return allowedScales.includes(value) ? value : 1;
        };
        const applyScale = (value) => {
          const scale = allowedScales.includes(value) ? value : 1;
          root.style.fontSize = `${scale * 100}%`;
          try { localStorage.setItem(scaleKey, String(scale)); } catch { /* preference persistence is optional */ }
        };
        const applyContrast = (enabled) => {
          root.classList.toggle('a11y-high-contrast', enabled);
          try { localStorage.setItem(contrastKey, enabled ? '1' : '0'); } catch { /* preference persistence is optional */ }
          const button = document.querySelector('[data-a11y="contrast"]');
          if (button) button.setAttribute('aria-pressed', enabled ? 'true' : 'false');
        };

        try {
          applyScale(readScale());
          applyContrast(localStorage.getItem(contrastKey) === '1');
        } catch { /* localStorage can be unavailable in strict privacy modes */ }

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-a11y]');
          if (!button) return;
          const action = button.dataset.a11y;
          if (action === 'contrast') {
            applyContrast(!root.classList.contains('a11y-high-contrast'));
            return;
          }
          let current = 1;
          try { current = readScale(); } catch { current = 1; }
          const index = allowedScales.indexOf(current);
          if (action === 'increase') applyScale(allowedScales[Math.min(index + 1, allowedScales.length - 1)]);
          if (action === 'decrease') applyScale(allowedScales[Math.max(index - 1, 0)]);
          if (action === 'reset') applyScale(1);
        });
      })();
    </script>

    <script is:inline src="/vendor/bootstrap.bundle.min.js?v=536"></script>
  </body>
</html>
