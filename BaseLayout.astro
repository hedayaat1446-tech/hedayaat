---
const { meta, lang = "ar", dir = lang === "ar" ? "rtl" : "ltr", skipLabel = lang === "ar" ? "تجاوز إلى المحتوى الرئيسي" : "Skip to main content", accessibilityLabel = lang === "ar" ? "أدوات إمكانية الوصول" : "Accessibility tools" } = Astro.props;
const isNotFound = Astro.url.pathname === "/404" || Astro.url.pathname === "/404/" || Astro.url.pathname.endsWith("/404.html");

// تنظيف الدومين
const baseUrl = (meta.url || "").replace(/\/+$/, "");

// canonical حسب المسار
const canonical = `${baseUrl}${Astro.url.pathname}`;

const localePairs = {
  "/": "/en/",
  "/board/": "/en/board/",
  "/governance/": "/en/governance/",
  "/transparency/": "/en/transparency/",
  "/accessibility/": "/en/accessibility/",
  "/privacy/": "/en/privacy/",
  "/reports/": "/en/reports/",
  "/news/": "/en/news/",
  "/photos/": "/en/photos/",
  "/videos/": "/en/videos/",
  "/participation/": "/en/participation/",
  "/thank/": "/en/thank/"
};
const reverseLocalePairs = Object.fromEntries(Object.entries(localePairs).map(([ar, en]) => [en, ar]));
const currentPath = Astro.url.pathname.endsWith("/") || Astro.url.pathname.includes(".")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const arPath = currentPath.startsWith("/en/") ? (reverseLocalePairs[currentPath] || "/") : currentPath;
const enPath = currentPath.startsWith("/en/") ? currentPath : (localePairs[currentPath] || "/en/");
const alternateAr = `${baseUrl}${arPath}`;
const alternateEn = `${baseUrl}${enPath}`;

const ogImageAbs = meta.ogImage?.startsWith("http")
  ? meta.ogImage
  : `${baseUrl}${meta.ogImage?.startsWith("/") ? "" : "/"}${meta.ogImage || ""}`;

const feedback = lang === "ar" ? {
  launcher: "شاركنا رأيك",
  title: "رأيك يهمنا",
  subtitle: "هل كانت هذه الصفحة مفيدة؟",
  yes: "نعم",
  somewhat: "إلى حد ما",
  no: "لا",
  commentLabel: "ملاحظة أو اقتراح (اختياري)",
  commentPlaceholder: "اكتبي ملاحظتك باختصار...",
  privacy: "لا نطلب أي بيانات شخصية في هذا التقييم.",
  submit: "إرسال الرأي",
  sending: "جارٍ الإرسال...",
  close: "إغلاق نافذة التقييم",
  choose: "اختاري أحد الخيارات أولًا.",
  failed: "تعذر إرسال رأيك الآن. حاولي مرة أخرى.",
  thanks: "شكرًا لك. تم تسجيل رأيك.",
  center: "مركز مشاركة المستفيد وقياس الرضا"
} : {
  launcher: "Share feedback",
  title: "Your feedback matters",
  subtitle: "Was this page helpful?",
  yes: "Yes",
  somewhat: "Somewhat",
  no: "No",
  commentLabel: "Comment or suggestion (optional)",
  commentPlaceholder: "Share a brief note...",
  privacy: "We do not ask for personal information in this feedback form.",
  submit: "Send feedback",
  sending: "Sending...",
  close: "Close feedback dialog",
  choose: "Please choose one option first.",
  failed: "We could not send your feedback right now. Please try again.",
  thanks: "Thank you. Your feedback has been recorded.",
  center: "Beneficiary Participation & Satisfaction"
};
// ===== Shared site chrome (header + breadcrumb + footer) for every inner page =====
import siteAr from "../content/site.json";
import siteEn from "../content/site-en.json";
const { chrome } = Astro.props;
const normPath = (p) => {
  let x = (p || "/").split("?")[0].split("#")[0];
  if (x.endsWith("/index.html")) x = x.slice(0, -10);
  if (x.endsWith(".html")) x = x.slice(0, -5) + "/";
  if (!x.endsWith("/")) x += "/";
  return x;
};
const here = normPath(Astro.url.pathname);
const isHomePage = here === "/" || here === "/en/";
const showChrome = chrome ?? !isHomePage;
const isAr = lang === "ar";
const chromeSite = isAr ? siteAr : siteEn;
const homeHref = isAr ? "/" : "/en/";
const fixHref = (h) => (h && h.startsWith("#") ? `${homeHref}${h}` : h);
const navItems = isAr
  ? siteAr.nav.filter((i) => i.enabled !== false).map((i) => ({ ...i, href: fixHref(i.href), children: i.children?.map((c) => ({ ...c, href: fixHref(c.href) })) }))
  : [
      { label: "About the Foundation", children: [
        { label: "Who we are", href: "/en/#about" }, { label: "Strategic Goals", href: "/en/#goals" },
        { label: "Our Values", href: "/en/#values" }, { label: "Organizational Management", href: "/en/board/" } ] },
      { label: "Programs", href: "/en/#programs" },
      { label: "Partnerships", href: "/en/#partners" },
      { label: "Governance", children: [
        { label: "Governance Center", href: "/en/governance/" }, { label: "Transparency & Disclosure", href: "/en/transparency/" },
        { label: "Financial Reports", href: "/en/reports/" } ] },
      { label: "Media Center", href: "/en/videos/" },
      { label: "Beneficiary Participation", href: "/en/participation/" },
      { label: "Contact", href: "/en/#contact" },
      { label: "Arabic", href: "/" }
    ];
const isCurrent = (h) => !!h && !h.includes("#") && normPath(h) === here && h !== homeHref;
const crumbMap = {
  "/board/": [["عن المؤسسة", "/#about"], ["الإدارة التنظيمية"]],
  "/governance/": [["الحوكمة"], ["مركز الحوكمة"]],
  "/transparency/": [["الحوكمة", "/governance/"], ["الشفافية والإفصاح"]],
  "/reports/": [["الحوكمة", "/governance/"], ["القوائم والتقارير المالية"]],
  "/videos/": [["المركز الإعلامي"], ["الفيديو"]],
  "/news/": [["المركز الإعلامي"], ["آخر الأخبار"]],
  "/photos/": [["المركز الإعلامي"], ["الصور"]],
  "/participation/": [["مشاركة المستفيد"]],
  "/privacy/": [["سياسة الخصوصية"]],
  "/accessibility/": [["بيان إمكانية الوصول"]],
  "/thank/": [["تواصل معنا", "/#contact"], ["تم استلام رسالتك"]],
  "/en/board/": [["About the Foundation", "/en/#about"], ["Organizational Management"]],
  "/en/governance/": [["Governance"], ["Governance Center"]],
  "/en/transparency/": [["Governance", "/en/governance/"], ["Transparency & Disclosure"]],
  "/en/reports/": [["Governance", "/en/governance/"], ["Financial Reports"]],
  "/en/videos/": [["Media Center"], ["Video"]],
  "/en/news/": [["Media Center"], ["News"]],
  "/en/photos/": [["Media Center"], ["Photos"]],
  "/en/participation/": [["Beneficiary Participation"]],
  "/en/privacy/": [["Privacy Policy"]],
  "/en/accessibility/": [["Accessibility Statement"]],
  "/en/thank/": [["Contact", "/en/#contact"], ["Message received"]]
};
const crumbs = crumbMap[here] || (isNotFound ? [[isAr ? "الصفحة غير موجودة" : "Page not found"]] : null);
const waDigitsChrome = String(chromeSite.contact?.phone || siteAr.contact?.phone || "").replace(/\D/g, "");
const waLinkChrome = `https://wa.me/${waDigitsChrome}`;
const licenseNo = siteAr.institution?.licenseNumber || "";

---

<!doctype html>
<html lang={lang} dir={dir} data-site-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {isNotFound && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any">


    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={alternateAr} />
    <link rel="alternate" hreflang="en" href={alternateEn} />

    <!-- Open Graph -->
    <meta property="og:locale" content={meta.locale || "ar_SA"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.siteName || "مؤسسة هدايات التعليمية"} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={meta.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Core UI assets are self-hosted so navigation/layout keep working even if an external CDN is unavailable. -->
    <link rel="stylesheet" href="/vendor/bootstrap.min.css?v=536" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons.min.css?v=local" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');

        const path = window.location.pathname;
        const isHome = path === '/' || path === '/en/' || path.endsWith('/index.html');
        if (!isHome) return;

        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

        // نحافظ على الروابط المقصودة مثل /#contact و /#about.
        // فقط إذا لم يوجد hash نمنع المتصفح من استعادة موضع تمرير قديم.
        if (!window.location.hash) {
          document.documentElement.style.scrollBehavior = 'auto';
          document.documentElement.scrollTop = 0;
          window.scrollTo(0, 0);
        }
      })();
    </script>

    <script is:inline>
      (() => {
        const html = document.documentElement;
        const currentLang = html.dataset.siteLang === 'en' ? 'en' : 'ar';

        const arToEn = {
          '/': '/en/',
          '/board/': '/en/board/',
          '/governance/': '/en/governance/',
          '/transparency/': '/en/transparency/',
          '/accessibility/': '/en/accessibility/',
          '/privacy/': '/en/privacy/',
          '/reports/': '/en/reports/',
          '/news/': '/en/news/',
          '/photos/': '/en/photos/',
          '/videos/': '/en/videos/',
          '/participation/': '/en/participation/',
          '/thank/': '/en/thank/'
        };
        const enToAr = Object.fromEntries(
          Object.entries(arToEn).map(([ar, en]) => [en, ar])
        );

        const normalize = (value) => {
          if (!value) return '/';
          let path = value.split('?')[0].split('#')[0] || '/';
          if (path === '/index.html') return '/';
          if (path === '/en/index.html') return '/en/';
          if (!path.endsWith('/') && !path.includes('.')) path += '/';
          return path;
        };

        const languageTarget = (path, lang) => {
          const normalized = normalize(path);
          if (lang === 'en') {
            return arToEn[normalized] || (normalized.startsWith('/en/') ? normalized : null);
          }
          return enToAr[normalized] || (!normalized.startsWith('/en/') ? normalized : null);
        };

        // The URL alone decides the language: /en/... is always English, everything else is always Arabic.
        // (A previous version remembered the last choice in localStorage and force-redirected every page to it,
        // which made it impossible to open the other language and caused pages to "bounce" between languages.)
        try { localStorage.removeItem('hedayat-language'); } catch {}

        document.addEventListener('click', (event) => {
          const link = event.target.closest('a[href]');
          if (!link) return;

          const requested = link.dataset.languageSwitch;
          if (requested === 'ar' || requested === 'en') {
            const target = languageTarget(link.pathname, requested) || (requested === 'en' ? '/en/' : '/');
            const hash = link.hash || (link.hasAttribute('data-keep-hash') ? location.hash : '');
            link.href = target + (link.search || '') + hash;
            return;
          }

          // Keep all internal navigation in the language currently being viewed.
          // This also protects against an accidental Arabic URL inside an English page (and vice versa).
          if (link.origin !== location.origin) return;
          const target = languageTarget(link.pathname, currentLang);
          if (!target || target === normalize(link.pathname)) return;

          link.href = target + (link.search || '') + (link.hash || '');
        }, true);
      })();
    </script>

    <link rel="stylesheet" href="/styles/site.css?v=47" />
    <slot name="head" />
  </head>

  <body class={showChrome ? "inner-page" : undefined}>
    <a class="skip-link" href="#main-content">{skipLabel}</a>

    <aside class="a11y-tools" aria-label={accessibilityLabel}>
      <a class="a11y-lang-switch" href={lang === "ar" ? enPath : arPath} data-language-switch={lang === "ar" ? "en" : "ar"} data-keep-hash hreflang={lang === "ar" ? "en" : "ar"} aria-label={lang === "ar" ? "EN — عرض هذه الصفحة باللغة الإنجليزية" : "AR — View this page in Arabic"} title={lang === "ar" ? "الإنجليزية" : "Arabic"}><i class="bi bi-globe2" aria-hidden="true"></i><span>{lang === "ar" ? "EN" : "AR"}</span></a>
      <button type="button" dir="ltr" data-a11y="decrease" aria-label={lang === "ar" ? "A− تصغير حجم النص" : "A− Decrease text size"} title={lang === "ar" ? "تصغير النص" : "Decrease text"}>A−</button>
      <button type="button" data-a11y="reset" aria-label={lang === "ar" ? "A إعادة حجم النص للوضع الافتراضي" : "A Reset text size"} title={lang === "ar" ? "الحجم الافتراضي" : "Default size"}>A</button>
      <button type="button" dir="ltr" data-a11y="increase" aria-label={lang === "ar" ? "A+ تكبير حجم النص" : "A+ Increase text size"} title={lang === "ar" ? "تكبير النص" : "Increase text"}>A+</button>
      <button type="button" data-a11y="contrast" aria-pressed="false" aria-label={lang === "ar" ? "تفعيل التباين العالي" : "Toggle high contrast"} title={lang === "ar" ? "تباين عالٍ" : "High contrast"}><i class="bi bi-circle-half" aria-hidden="true"></i></button>
    </aside>


    {showChrome && (
      <>
        <nav class="navbar navbar-expand-lg fixed-top hdr site-chrome-hdr" aria-label={isAr ? "القائمة الرئيسية" : "Primary navigation"}>
          <div class="container align-items-center">
            <a class="navbar-brand d-flex align-items-center" href={homeHref}>
              <img src={chromeSite.assets?.logoNav || "/hedayat-logo-gold.png"} alt={isAr ? "شعار مؤسسة هدايات التعليمية" : "Hedayat Educational Foundation logo"} class="official-logo official-logo-nav" width="900" height="337" />
              <span class="visually-hidden">{isAr ? "الصفحة الرئيسية" : "Home page"}</span>
            </a>
            <a class="whatsapp-btn d-flex d-lg-none ms-auto me-2" href={waLinkChrome} target="_blank" rel="noopener" aria-label={isAr ? "تواصل عبر واتساب" : "Contact us on WhatsApp"} title={isAr ? "تواصل عبر واتساب" : "Contact us on WhatsApp"}><i class="bi bi-whatsapp" aria-hidden="true"></i></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navChrome" aria-controls="navChrome" aria-expanded="false" aria-label={isAr ? "إظهار القائمة" : "Open navigation menu"}><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navChrome">
              <ul class="navbar-nav nav-rtl mx-auto gap-lg-2">
                {navItems.map((item) => item.children?.length ? (
                  <li class={`nav-item dropdown hedayat-nav-group${item.children.some((c) => isCurrent(c.href)) ? " is-current" : ""}`}>
                    <button class="nav-link dropdown-toggle nav-dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" aria-expanded="false">{item.label}</button>
                    <ul class="dropdown-menu hedayat-dropdown">
                      {item.children.map((c) => (<li><a class={`dropdown-item${isCurrent(c.href) ? " active" : ""}`} href={c.href} aria-current={isCurrent(c.href) ? "page" : undefined}>{c.label}</a></li>))}
                    </ul>
                  </li>
                ) : (
                  <li class="nav-item">
                    {(item.href === "/en/" || item.href === "/")
                      ? <a class="nav-link" href={isAr ? enPath : arPath} lang={isAr ? "en" : "ar"} dir={isAr ? "ltr" : "rtl"} data-language-switch={isAr ? "en" : "ar"}>{item.label}</a>
                      : <a class={`nav-link${isCurrent(item.href) ? " active" : ""}`} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>}
                  </li>
                ))}
              </ul>
              <div class="d-none d-lg-flex ms-lg-3">
                <a class="whatsapp-btn" href={waLinkChrome} target="_blank" rel="noopener" aria-label={isAr ? "تواصل عبر واتساب" : "Contact us on WhatsApp"} title={isAr ? "تواصل عبر واتساب" : "Contact us on WhatsApp"}><i class="bi bi-whatsapp" aria-hidden="true"></i></a>
              </div>
            </div>
          </div>
        </nav>
        <div class="brand-ribbon" role="presentation" aria-hidden="true"></div>
        {crumbs && (
          <nav class="crumbs" aria-label={isAr ? "مسار الصفحة" : "Breadcrumb"}>
            <ol>
              <li><a href={homeHref}><i class="bi bi-house-door" aria-hidden="true"></i> {isAr ? "الرئيسية" : "Home"}</a></li>
              {crumbs.map(([label, href], i) => (
                <li>
                  <span class="crumb-sep" aria-hidden="true">{isAr ? "‹" : "›"}</span>
                  {i === crumbs.length - 1
                    ? <span aria-current="page">{label}</span>
                    : href ? <a href={href}>{label}</a> : <span>{label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
      </>
    )}

    <slot />


    {showChrome && (
      <footer class="site-footer">
        <img src="/identity-grid.png" alt="" aria-hidden="true" loading="lazy" decoding="async" class="footer-watermark footer-watermark--start" />
        <img src="/identity-grid.png" alt="" aria-hidden="true" loading="lazy" decoding="async" class="footer-watermark footer-watermark--end" />
        <div class="footer-top">
          <div class="footer-logos">
            <img src={chromeSite.assets?.logoNav || "/hedayat-logo-gold.png"} alt={isAr ? "شعار مؤسسة هدايات التعليمية" : "Hedayat Educational Foundation logo"} class="official-logo official-logo-footer" loading="lazy" decoding="async" width="900" height="337" />
            <img src={chromeSite.assets?.nationalCenterLogo || "/national-center-logo.png"} alt={isAr ? "شعار المركز الوطني لتنمية القطاع غير الربحي" : "National Center for Non-Profit Sector logo"} class="footer-logo national-center-footer-logo" loading="lazy" decoding="async" width="660" height="306" />
          </div>
          <p class="footer-license">{isAr ? siteAr.footer.licenseText : `Licensed by the National Center for Non-Profit Sector — License No. ${licenseNo}`}</p>
          <nav class="footer-links" aria-label={isAr ? "روابط أسفل الصفحة" : "Footer links"}>
            {(isAr
              ? [["الرئيسية", "/"], ["مركز الحوكمة", "/governance/"], ["الشفافية والإفصاح", "/transparency/"], ["إمكانية الوصول", "/accessibility/"], ["مشاركة المستفيد", "/participation/"], ["تواصل معنا", "/#contact"], ["سياسة الخصوصية", "/privacy/"]]
              : [["Home", "/en/"], ["Governance", "/en/governance/"], ["Transparency", "/en/transparency/"], ["Accessibility", "/en/accessibility/"], ["Beneficiary Participation", "/en/participation/"], ["Contact", "/en/#contact"], ["Privacy", "/en/privacy/"]]
            ).map(([label, href]) => (<><a href={href}>{label}</a><span aria-hidden="true">•</span></>))}
            <a href={isAr ? enPath : arPath} lang={isAr ? "en" : "ar"} dir={isAr ? "ltr" : "rtl"} data-language-switch={isAr ? "en" : "ar"}>{isAr ? "English" : "Arabic"}</a>
          </nav>
        </div>
        <hr class="footer-divider" />
        <div class="footer-bottom"><div class="footer-copy">{isAr ? siteAr.footer.copyrightText.replace("{year}", String(new Date().getFullYear())) : `All rights reserved © ${new Date().getFullYear()} Hedayat`}</div></div>
      </footer>
    )}

    {showChrome && (
      <script is:inline>
        (() => {
          const hdr = document.querySelector('.site-chrome-hdr');
          if (!hdr) return;
          const onScroll = () => hdr.classList.toggle('scrolled', window.scrollY > 60);
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        })();
      </script>
    )}

    {!isNotFound && (
      <div class="page-feedback" data-feedback-root data-lang={lang} data-sending={feedback.sending} data-choose={feedback.choose} data-failed={feedback.failed} data-thanks={feedback.thanks}>
        <button class="feedback-launcher" type="button" data-feedback-open aria-haspopup="dialog" aria-controls="feedbackDialog">
          <i class="bi bi-chat-dots" aria-hidden="true"></i>
          <span>{feedback.launcher}</span>
        </button>

        <dialog id="feedbackDialog" class="feedback-dialog" aria-labelledby="feedbackTitle" aria-describedby="feedbackSubtitle">
          <form class="feedback-form" data-feedback-form novalidate>
            <div class="feedback-head">
              <div>
                <h2 id="feedbackTitle">{feedback.title}</h2>
                <p id="feedbackSubtitle">{feedback.subtitle}</p>
              </div>
              <button class="feedback-close" type="button" data-feedback-close aria-label={feedback.close} title={feedback.close}>×</button>
            </div>

            <fieldset class="feedback-choices">
              <legend class="visually-hidden">{feedback.subtitle}</legend>
              <label><input type="radio" name="choice" value="yes" /><span><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i>{feedback.yes}</span></label>
              <label><input type="radio" name="choice" value="somewhat" /><span><i class="bi bi-dash-circle" aria-hidden="true"></i>{feedback.somewhat}</span></label>
              <label><input type="radio" name="choice" value="no" /><span><i class="bi bi-hand-thumbs-down" aria-hidden="true"></i>{feedback.no}</span></label>
            </fieldset>

            <label class="feedback-comment-label" for="feedbackComment">{feedback.commentLabel}</label>
            <textarea id="feedbackComment" name="comment" maxlength="1200" rows="4" placeholder={feedback.commentPlaceholder}></textarea>
            <input class="feedback-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="feedback-privacy"><i class="bi bi-shield-check" aria-hidden="true"></i>{feedback.privacy}</p>
            <a class="feedback-center-link" href={lang === "ar" ? "/participation/" : "/en/participation/"}><i class="bi bi-people" aria-hidden="true"></i>{feedback.center}</a>
            <div class="feedback-actions">
              <button class="feedback-submit" type="submit">{feedback.submit}</button>
              <div class="feedback-status" data-feedback-status role="status" aria-live="polite"></div>
            </div>
          </form>
        </dialog>
      </div>
    )}

    {!isNotFound && (
      <script is:inline>
        (() => {
          const root = document.querySelector('[data-feedback-root]');
          if (!root) return;
          const feedbackLang = root.dataset.lang === 'en' ? 'en' : 'ar';
          const feedbackSending = root.dataset.sending || '';
          const feedbackChoose = root.dataset.choose || '';
          const feedbackFailed = root.dataset.failed || '';
          const feedbackThanks = root.dataset.thanks || '';
          const dialog = root.querySelector('.feedback-dialog');
          const openButton = root.querySelector('[data-feedback-open]');
          const closeButton = root.querySelector('[data-feedback-close]');
          const form = root.querySelector('[data-feedback-form]');
          const status = root.querySelector('[data-feedback-status]');
          const submitButton = root.querySelector('.feedback-submit');

          const setStatus = (message, type = '') => {
            status.textContent = message || '';
            status.dataset.state = type;
          };

          const openDialog = () => {
            setStatus('');
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', '');
          };
          const closeDialog = () => {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          };

          openButton.addEventListener('click', openDialog);
          closeButton.addEventListener('click', closeDialog);
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const inside = event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom;
            if (!inside) closeDialog();
          });

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const choice = String(data.get('choice') || '');
            if (!choice) {
              setStatus(feedbackChoose, 'error');
              form.querySelector('input[name="choice"]')?.focus();
              return;
            }

            submitButton.disabled = true;
            setStatus(feedbackSending, 'loading');
            try {
              const response = await fetch('/api/feedback', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                  choice,
                  comment: String(data.get('comment') || ''),
                  'bot-field': String(data.get('bot-field') || ''),
                  lang: feedbackLang,
                  page: window.location.pathname
                })
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok) throw new Error(payload.message || feedbackFailed);
              form.reset();
              setStatus(payload.message || feedbackThanks, 'success');
              openButton.classList.add('feedback-sent');
              setTimeout(closeDialog, 1400);
            } catch (error) {
              setStatus(error?.message || feedbackFailed, 'error');
            } finally {
              submitButton.disabled = false;
            }
          });
        })();
      </script>
    )}

    <script is:inline>
      (() => {
        const path = window.location.pathname;
        const isHome = path === '/' || path === '/en/' || path.endsWith('/index.html');
        if (!isHome) return;

        let userInteracted = false;
        const markInteraction = () => { userInteracted = true; };
        ['touchstart', 'pointerdown', 'mousedown', 'keydown', 'wheel'].forEach((eventName) => {
          window.addEventListener(eventName, markInteraction, { passive: true, once: true });
        });

        const applyInitialPosition = () => {
          const hash = window.location.hash;
          if (hash) {
            let id = hash.slice(1);
            try { id = decodeURIComponent(id); } catch { /* keep the raw fragment if it is malformed */ }
            const target = document.getElementById(id);
            if (target) target.scrollIntoView({ block: 'start', behavior: 'auto' });
            return;
          }
          if (userInteracted) return;
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        };

        const runPositionPasses = () => {
          applyInitialPosition();
          requestAnimationFrame(() => requestAnimationFrame(applyInitialPosition));
          [80, 250, 700].forEach((delay) => setTimeout(applyInitialPosition, delay));
        };

        document.addEventListener('DOMContentLoaded', runPositionPasses, { once: true });
        window.addEventListener('load', runPositionPasses, { once: true });
        window.addEventListener('pageshow', () => {
          userInteracted = false;
          runPositionPasses();
        });

        setTimeout(() => { document.documentElement.style.scrollBehavior = ''; }, 900);
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const scaleKey = 'hedayat-font-scale';
        const contrastKey = 'hedayat-high-contrast';
        const allowedScales = [0.9, 1, 1.125, 1.25];

        const readScale = () => {
          const value = Number(localStorage.getItem(scaleKey) || '1');
          return allowedScales.includes(value) ? value : 1;
        };
        const applyScale = (value) => {
          const scale = allowedScales.includes(value) ? value : 1;
          root.style.fontSize = `${scale * 100}%`;
          try { localStorage.setItem(scaleKey, String(scale)); } catch { /* preference persistence is optional */ }
        };
        const applyContrast = (enabled) => {
          root.classList.toggle('a11y-high-contrast', enabled);
          try { localStorage.setItem(contrastKey, enabled ? '1' : '0'); } catch { /* preference persistence is optional */ }
          const button = document.querySelector('[data-a11y="contrast"]');
          if (button) button.setAttribute('aria-pressed', enabled ? 'true' : 'false');
        };

        try {
          applyScale(readScale());
          applyContrast(localStorage.getItem(contrastKey) === '1');
        } catch { /* localStorage can be unavailable in strict privacy modes */ }

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-a11y]');
          if (!button) return;
          const action = button.dataset.a11y;
          if (action === 'contrast') {
            applyContrast(!root.classList.contains('a11y-high-contrast'));
            return;
          }
          let current = 1;
          try { current = readScale(); } catch { current = 1; }
          const index = allowedScales.indexOf(current);
          if (action === 'increase') applyScale(allowedScales[Math.min(index + 1, allowedScales.length - 1)]);
          if (action === 'decrease') applyScale(allowedScales[Math.max(index - 1, 0)]);
          if (action === 'reset') applyScale(1);
        });
      })();
    </script>

    <script is:inline src="/vendor/bootstrap.bundle.min.js?v=536"></script>
  </body>
</html>
