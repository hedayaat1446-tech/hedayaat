    {!isNotFound && (
      <script is:inline>
        (() => {
          const root = document.querySelector('[data-feedback-root]');
          if (!root) return;
          const feedbackLang = root.dataset.lang === 'en' ? 'en' : 'ar';
          const feedbackSending = root.dataset.sending || '';
          const feedbackChoose = root.dataset.choose || '';
          const feedbackFailed = root.dataset.failed || '';
          const feedbackThanks = root.dataset.thanks || '';
          const dialog = root.querySelector('.feedback-dialog');
          const openButton = root.querySelector('[data-feedback-open]');
          const closeButton = root.querySelector('[data-feedback-close]');
          const form = root.querySelector('[data-feedback-form]');
          const status = root.querySelector('[data-feedback-status]');
          const submitButton = root.querySelector('.feedback-submit');

          const setStatus = (message, type = '') => {
            status.textContent = message || '';
            status.dataset.state = type;
          };

          const openDialog = () => {
            setStatus('');
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', '');
          };
          const closeDialog = () => {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          };

          openButton.addEventListener('click', openDialog);
          closeButton.addEventListener('click', closeDialog);
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const inside = event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom;
            if (!inside) closeDialog();
          });

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const choice = String(data.get('choice') || '');
            if (!choice) {
              setStatus(feedbackChoose, 'error');
              form.querySelector('input[name="choice"]')?.focus();
              return;
            }

            submitButton.disabled = true;
            setStatus(feedbackSending, 'loading');
            try {
              const response = await fetch('/api/feedback', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                  choice,
                  comment: String(data.get('comment') || ''),
                  'bot-field': String(data.get('bot-field') || ''),
                  lang: feedbackLang,
                  page: window.location.pathname
                })
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok) throw new Error(payload.message || feedbackFailed);
              form.reset();
              setStatus(payload.message || feedbackThanks, 'success');
              openButton.classList.add('feedback-sent');
              setTimeout(closeDialog, 1400);
            } catch (error) {
              setStatus(error?.message || feedbackFailed, 'error');
            } finally {
              submitButton.disabled = false;
            }
          });
        })();
      </script>
    )}

    <script is:inline>
      (() => {
        const path = window.location.pathname;
        const isHome = path === '/' || path === '/en/' || path.endsWith('/index.html');
        if (!isHome) return;

        let userInteracted = false;
        const markInteraction = () => { userInteracted = true; };
        ['touchstart', 'pointerdown', 'mousedown', 'keydown', 'wheel'].forEach((eventName) => {
          window.addEventListener(eventName, markInteraction, { passive: true, once: true });
        });

        const applyInitialPosition = () => {
          const hash = window.location.hash;
          if (hash) {
            let id = hash.slice(1);
            try { id = decodeURIComponent(id); } catch { /* keep the raw fragment if it is malformed */ }
            const target = document.getElementById(id);
            if (target) target.scrollIntoView({ block: 'start', behavior: 'auto' });
            return;
          }
          if (userInteracted) return;
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        };

        const runPositionPasses = () => {
          applyInitialPosition();
          requestAnimationFrame(() => requestAnimationFrame(applyInitialPosition));
          [80, 250, 700].forEach((delay) => setTimeout(applyInitialPosition, delay));
        };

        document.addEventListener('DOMContentLoaded', runPositionPasses, { once: true });
        window.addEventListener('load', runPositionPasses, { once: true });
        window.addEventListener('pageshow', () => {
          userInteracted = false;
          runPositionPasses();
        });

        setTimeout(() => { document.documentElement.style.scrollBehavior = ''; }, 900);
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const scaleKey = 'hedayat-font-scale';
        const contrastKey = 'hedayat-high-contrast';
        const allowedScales = [0.9, 1, 1.125, 1.25];

        const readScale = () => {
          const value = Number(localStorage.getItem(scaleKey) || '1');
          return allowedScales.includes(value) ? value : 1;
        };
        const applyScale = (value) => {
          const scale = allowedScales.includes(value) ? value : 1;
          root.style.fontSize = `${scale * 100}%`;
          try { localStorage.setItem(scaleKey, String(scale)); } catch { /* preference persistence is optional */ }
        };
        const applyContrast = (enabled) => {
          root.classList.toggle('a11y-high-contrast', enabled);
          try { localStorage.setItem(contrastKey, enabled ? '1' : '0'); } catch { /* preference persistence is optional */ }
          const button = document.querySelector('[data-a11y="contrast"]');
          if (button) button.setAttribute('aria-pressed', enabled ? 'true' : 'false');
        };

        try {
          applyScale(readScale());
          applyContrast(localStorage.getItem(contrastKey) === '1');
        } catch { /* localStorage can be unavailable in strict privacy modes */ }

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-a11y]');
          if (!button) return;
          const action = button.dataset.a11y;
          if (action === 'contrast') {
            applyContrast(!root.classList.contains('a11y-high-contrast'));
            return;
          }
          let current = 1;
          try { current = readScale(); } catch { current = 1; }
          const index = allowedScales.indexOf(current);
          if (action === 'increase') applyScale(allowedScales[Math.min(index + 1, allowedScales.length - 1)]);
          if (action === 'decrease') applyScale(allowedScales[Math.max(index - 1, 0)]);
          if (action === 'reset') applyScale(1);
        });
      })();
    </script>

    <script is:inline>
      // ===== Site UI: header, theme, accessibility menu, back-to-top, reveal, count-up, search, document viewer, PWA =====
      (() => {
        const root = document.documentElement;
        const isAr = root.lang !== 'en';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Header shrinks after scrolling; back-to-top appears.
        const hdr = document.querySelector('.site-chrome-hdr');
        const toTop = document.querySelector('[data-back-to-top]');
        const onScroll = () => {
          const y = window.scrollY;
          if (hdr) hdr.classList.toggle('scrolled', y > 40);
          if (toTop) toTop.hidden = y < 700;
        };
        window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
        toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));

        // Close the mobile menu after choosing a destination link.
        document.addEventListener('click', (e) => {
          const link = e.target.closest('#navChrome a.nav-link, #navChrome a.dropdown-item, #navChrome a.hdr-cta');
          const toggler = document.querySelector('.site-chrome-hdr .navbar-toggler');
          if (link && toggler && getComputedStyle(toggler).display !== 'none' && toggler.getAttribute('aria-expanded') === 'true') toggler.click();
        });

        // Light / dark theme.
        const themeButtons = document.querySelectorAll('[data-theme-toggle]');
        const paintTheme = () => {
          const dark = root.getAttribute('data-theme') === 'dark';
          themeButtons.forEach((b) => {
            b.setAttribute('aria-pressed', dark ? 'true' : 'false');
            const label = dark ? b.dataset.labelLight : b.dataset.labelDark;
            b.setAttribute('aria-label', label); b.title = label;
            const icon = b.querySelector('i'); if (icon) icon.className = `bi ${dark ? 'bi-sun' : 'bi-moon-stars'}`;
            const span = b.querySelector('span'); if (span) span.textContent = label;
          });
          const meta = document.querySelector('meta[name="theme-color"]'); if (meta) meta.content = dark ? '#0B1418' : '#16404F';
        };
        themeButtons.forEach((b) => b.addEventListener('click', () => {
          const dark = root.getAttribute('data-theme') !== 'dark';
          if (dark) root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme');
          try { localStorage.setItem('hedayat-theme', dark ? 'dark' : 'light'); } catch {}
          paintTheme();
        }));
        paintTheme();

        // Accessibility menu (one button that opens the tools).
        const a11yBtn = document.querySelector('[data-a11y-toggle]');
        const a11yPanel = document.getElementById('a11yPanel');
        const setA11y = (open) => { if (!a11yBtn || !a11yPanel) return; a11yPanel.hidden = !open; a11yBtn.setAttribute('aria-expanded', open ? 'true' : 'false'); };
        a11yBtn?.addEventListener('click', (e) => { e.stopPropagation(); setA11y(a11yPanel.hidden); });
        document.addEventListener('click', (e) => { if (a11yPanel && !a11yPanel.hidden && !e.target.closest('.a11y-wrap')) setA11y(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && a11yPanel && !a11yPanel.hidden) { setA11y(false); a11yBtn.focus(); } });

        // Reveal on scroll + count-up numbers.
        const countUp = (el) => {
          const target = parseFloat(el.dataset.countTo); if (!Number.isFinite(target)) return;
          const decimals = (el.dataset.countTo.split('.')[1] || '').length;
          if (reduceMotion) { el.textContent = target.toFixed(decimals); return; }
          const start = performance.now(), dur = 1100;
          const step = (t) => { const k = Math.min(1, (t - start) / dur); const v = target * (1 - Math.pow(1 - k, 3)); el.textContent = v.toFixed(decimals); if (k < 1) requestAnimationFrame(step); };
          requestAnimationFrame(step);
        };
        window.hedayatCountUp = countUp;
        const revealEls = document.querySelectorAll('.reveal-on-scroll, [data-count-to]');
        if ('IntersectionObserver' in window && !reduceMotion) {
          const io = new IntersectionObserver((entries) => entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('is-visible');
            if (en.target.dataset.countTo) countUp(en.target);
            io.unobserve(en.target);
          }), { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
          revealEls.forEach((el) => io.observe(el));
        } else revealEls.forEach((el) => { el.classList.add('is-visible'); if (el.dataset.countTo) countUp(el); });

        // Site search (index generated at build time).
        const dlg = document.getElementById('siteSearch');
        const input = document.getElementById('siteSearchInput');
        const results = document.getElementById('siteSearchResults');
        let index = null;
        const norm = (t) => String(t || '').toLowerCase()
          .replace(/[ً-ْـ]/g, '').replace(/[أإآٱ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي').replace(/ؤ/g, 'و').replace(/ئ/g, 'ي')
          .replace(/[^\p{L}\p{N}\s]/gu, ' ').replace(/\s+/g, ' ').trim();
        const esc = (t) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const loadIndex = async () => {
          if (index) return index;
          try { const r = await fetch('/search-index.json', { cache: 'no-cache' }); const all = await r.json(); index = all.filter((d) => d.lang === (isAr ? 'ar' : 'en')).map((d) => ({ ...d, _t: norm(d.title), _h: norm((d.headings || []).join(' ')), _x: norm(d.text) })); }
          catch { index = []; }
          return index;
        };
        const snippet = (text, words) => {
          const low = text.toLowerCase(); let pos = -1;
          for (const w of words) { const i = norm(low).indexOf(w); if (i >= 0) { pos = i; break; } }
          const startAt = Math.max(0, pos - 60);
          return (startAt > 0 ? '…' : '') + text.slice(startAt, startAt + 170) + (text.length > startAt + 170 ? '…' : '');
        };
        const render = async () => {
          const q = norm(input.value);
          if (q.length < 2) { results.innerHTML = `<p class="search-hint">${esc(results.dataset.hint)}</p>`; return; }
          const words = q.split(' ').filter((w) => w.length > 1);
          const docs = await loadIndex();
          const scored = docs.map((d) => {
            let score = 0;
            for (const w of words) {
              if (d._t.includes(w)) score += 10;
              if (d._h.includes(w)) score += 4;
              if (d._x.includes(w)) score += 1;
              else if (!d._t.includes(w) && !d._h.includes(w)) return { d, score: 0 };
            }
            return { d, score };
          }).filter((x) => x.score > 0).sort((a, b) => b.score - a.score).slice(0, 12);
          if (!scored.length) { results.innerHTML = `<p class="search-empty">${esc(results.dataset.empty)}</p>`; return; }
          results.innerHTML = '<ul>' + scored.map(({ d }) => `<li><a href="${esc(d.url)}"${d.type === 'pdf' ? ' data-doc-title="' + esc(d.title) + '"' : ''}><span class="sr-type">${esc(d.section || '')}</span><strong>${esc(d.title)}</strong><small>${esc(snippet(d.text || '', words))}</small></a></li>`).join('') + '</ul>';
        };
        let tm; input?.addEventListener('input', () => { clearTimeout(tm); tm = setTimeout(render, 120); });
        input?.addEventListener('keydown', (e) => {
          const links = [...results.querySelectorAll('a')]; if (!links.length) return;
          if (e.key === 'ArrowDown' || e.key === 'Enter') { e.preventDefault(); if (e.key === 'Enter') links[0].click(); else links[0].focus(); }
        });
        results?.addEventListener('keydown', (e) => {
          const links = [...results.querySelectorAll('a')]; const i = links.indexOf(document.activeElement); if (i < 0) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); links[Math.min(i + 1, links.length - 1)].focus(); }
          if (e.key === 'ArrowUp') { e.preventDefault(); (i === 0 ? input : links[i - 1]).focus(); }
        });
        const openSearch = () => { if (!dlg) return; dlg.showModal?.(); loadIndex(); setTimeout(() => input?.focus(), 30); };
        document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', openSearch));
        document.querySelector('[data-search-close]')?.addEventListener('click', () => dlg.close());
        dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        results?.addEventListener('click', (e) => { if (e.target.closest('a')) dlg.close(); });
        document.addEventListener('keydown', (e) => {
          const typing = /input|textarea|select/i.test(document.activeElement?.tagName || '') || document.activeElement?.isContentEditable;
          if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) { e.preventDefault(); openSearch(); }
        });

        // In-page PDF viewer (desktop & tablets); phones keep the native PDF viewer.
        const viewer = document.getElementById('docViewer');
        const frame = viewer?.querySelector('iframe');
        const canEmbedPdf = () => window.innerWidth >= 768 && !/iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        document.addEventListener('click', (e) => {
          const a = e.target.closest('a[href]'); if (!a || !viewer || e.defaultPrevented) return;
          if (a.hasAttribute('download') || a.hasAttribute('data-no-viewer') || e.ctrlKey || e.metaKey || e.shiftKey) return;
          let url; try { url = new URL(a.href, location.href); } catch { return; }
          if (url.origin !== location.origin || !/\.pdf$/i.test(url.pathname) || !canEmbedPdf()) return;
          e.preventDefault();
          const title = a.dataset.docTitle || a.closest('article,section,li,div')?.querySelector('h2,h3,strong')?.textContent?.trim() || a.textContent.trim();
          viewer.querySelector('.doc-viewer-title').textContent = title || viewer.querySelector('.doc-viewer-title').textContent;
          viewer.querySelector('.doc-viewer-download').href = url.pathname;
          viewer.querySelector('.doc-viewer-open').href = url.pathname;
          frame.src = url.pathname + '#view=FitH';
          if (dlg?.open) dlg.close();
          viewer.showModal?.();
        });
        viewer?.querySelector('[data-doc-close]')?.addEventListener('click', () => viewer.close());
        viewer?.addEventListener('close', () => { if (frame) frame.src = 'about:blank'; });
        viewer?.addEventListener('click', (e) => { if (e.target === viewer) viewer.close(); });

        // Installable app: register the service worker.
        if ('serviceWorker' in navigator && location.protocol === 'https:') {
          window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
        }
      })();
    </script>

