---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../content/site.json";

const institution = site.institution;
const waDigits = (site.contact.phone || "").replace(/\D/g, "");
const waMessage = "Hello, I would like to inquire about Hedayat Educational Foundation programs.";
const waLink = `https://wa.me/${waDigits}?text=${encodeURIComponent(waMessage)}`;
const meta = {
  ...site.meta,
  title: "Hedayat Educational Foundation",
  description: "Official English website of Hedayat Educational Foundation — a licensed educational civil foundation providing reliable knowledge through purposeful programs, qualified expertise and accessible contemporary methods.",
  locale: "en_SA",
  siteName: "Hedayat Educational Foundation"
};

const goals = [
  { title: "Empowering the next generation (girls)", text: "Enabling girls to distinguish reliable knowledge from misleading claims and build strong intellectual and values-based resilience.", icon: "bi bi-shield-check" },
  { title: "Building educational capabilities", text: "Preparing educational practitioners who can deepen understanding and conviction rather than merely transfer information.", icon: "bi bi-mortarboard-fill" },
  { title: "Keeping pace with emerging issues", text: "Helping educators connect learning content with contemporary developments and current intellectual questions.", icon: "bi bi-lightning-charge-fill" },
  { title: "Financial sustainability", text: "Supporting long-term continuity of programs and expanding sustainable community impact.", icon: "bi bi-cash-coin" }
];

const values = [
  { title: "Quality", text: "High standards in program delivery and outcomes, supported by continuous review and improvement.", icon: "bi bi-star-fill" },
  { title: "Credibility & transparency", text: "Clear objectives, measurable outcomes and transparent communication with stakeholders.", icon: "bi bi-patch-check-fill" },
  { title: "Collaboration", text: "Effective partnerships with educational and non-profit entities to strengthen impact and reduce duplication.", icon: "bi bi-people-fill" },
  { title: "Innovation", text: "Contemporary educational solutions and media that speak effectively to today’s generation.", icon: "bi bi-lightbulb-fill" },
  { title: "Flexibility", text: "The ability to evolve and respond to emerging needs and community priorities.", icon: "bi bi-arrow-repeat" }
];
---

<BaseLayout meta={meta} lang="en" dir="ltr" skipLabel="Skip to main content" accessibilityLabel="Accessibility tools">
  <nav class="navbar navbar-expand-lg fixed-top hdr" aria-label="Primary navigation">
    <div class="container align-items-center">
      <a class="navbar-brand d-flex align-items-center" href="#home" style="background:transparent !important; background-color:transparent !important; box-shadow:none !important; border:0 !important; border-radius:0 !important; padding:0 !important;">
        <img src={site.assets.logoNav} alt="Hedayat Educational Foundation logo" class="official-logo official-logo-nav" style="display:block; height:48px; width:auto; max-width:min(56vw,340px); object-fit:contain; background:transparent !important; background-color:transparent !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; padding:0 !important; margin:0 !important;" />
        <span class="visually-hidden">Go to the top of the page</span>
      </a>

      <a class="whatsapp-btn d-flex d-lg-none ms-auto me-2" href={waLink} target="_blank" rel="noopener" aria-label="Contact us on WhatsApp" title="Contact us on WhatsApp">
        <i class="bi bi-whatsapp" aria-hidden="true"></i>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMainEn" aria-controls="navMainEn" aria-expanded="false" aria-label="Open navigation menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMainEn">
        <ul class="navbar-nav nav-rtl mx-auto gap-lg-2">
          <li class="nav-item dropdown hedayat-nav-group">
            <button class="nav-link dropdown-toggle nav-dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" aria-expanded="false">About the Foundation</button>
            <ul class="dropdown-menu hedayat-dropdown">
              <li><a class="dropdown-item" href="#about">Who we are</a></li>
              <li><a class="dropdown-item" href="#vision">Vision & Mission</a></li>
              <li><a class="dropdown-item" href="#goals">Strategic Goals</a></li>
              <li><a class="dropdown-item" href="#values">Our Values</a></li>
              <li><a class="dropdown-item" href="/board/">Board of Trustees</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="#programs">Programs</a></li>
          <li class="nav-item"><a class="nav-link" href="#partners">Partnerships</a></li>
          <li class="nav-item dropdown hedayat-nav-group">
            <button class="nav-link dropdown-toggle nav-dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" aria-expanded="false">Governance</button>
            <ul class="dropdown-menu hedayat-dropdown">
              <li><a class="dropdown-item" href="#governance">Governance overview</a></li>
              <li><a class="dropdown-item" href="/governance/">Governance Center</a></li>
              <li><a class="dropdown-item" href="/transparency/">Transparency & Disclosure</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="/en/videos/">Media Center</a></li>
          <li class="nav-item"><a class="nav-link" href="/en/participation/">Beneficiary Participation</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
          <li class="nav-item"><a class="nav-link" href="/" lang="ar" dir="rtl">العربية</a></li>
        </ul>

        <div class="d-none d-lg-flex ms-lg-3">
          <a class="whatsapp-btn" href={waLink} target="_blank" rel="noopener" aria-label="Contact us on WhatsApp" title="Contact us on WhatsApp">
            <i class="bi bi-whatsapp" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <div class="brand-ribbon" role="presentation" aria-hidden="true"></div>

  <style is:inline>
    .official-logo, .official-logo-hero-wrap, .navbar-brand:has(.official-logo) {
      background: transparent !important;
      background-color: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
    .official-logo { padding: 0 !important; }
    @media (max-width: 768px) {
      .official-logo-nav { height: 39px !important; max-width: min(48vw, 190px) !important; }
      .official-logo-hero { width: min(88vw, 470px) !important; }
      .official-logo-footer { width: min(58vw, 220px) !important; }
    }
  </style>

  <main id="main-content">
    <section id="home" class="hero-section" style={{ "--hero-bg": `url(${site.assets.heroBackground})` }}>
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="official-logo-hero-wrap mb-5" style="display:flex; justify-content:center; align-items:center; width:100%; background:transparent !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; padding:0 !important;">
              <img src={site.assets.logoHero} alt="Hedayat Educational Foundation logo" class="official-logo official-logo-hero" style="display:block; width:min(82vw,620px); height:auto; max-width:100%; object-fit:contain; background:transparent !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; padding:0 !important; margin:0 auto !important;" />
            </div>
            <div class="hero-copy">
              <h1 class="display-6 fw-bold hero-title mb-3">A Beacon of Guidance for Deeper Community Awareness</h1>
              <p class="lead hero-lead mb-4">A trusted educational foundation specialized in providing reliable knowledge that supports the nation’s higher values through purposeful programs, qualified expertise and accessible, engaging methods.</p>
              <div class="d-flex flex-wrap justify-content-center gap-2 gap-md-3 mt-2">
                <a href="#about" class="btn-cta-secondary">Discover the Foundation</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <svg class="hero-wave" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160" preserveAspectRatio="none">
        <path fill="#F7F4EE" opacity="0.98" d="M0,80 C240,120 480,40 720,80 C960,120 1200,60 1440,90 L1440,160 L0,160 Z"></path>
        <path fill="#EEF2E8" opacity="0.88" d="M0,90 C240,130 480,50 720,90 C960,130 1200,70 1440,100 L1440,160 L0,160 Z"></path>
        <path fill="#E8F2F1" opacity="0.72" d="M0,100 C240,140 480,60 720,100 C960,140 1200,80 1440,110 L1440,160 L0,160 Z"></path>
      </svg>
    </section>

    <section id="about" class="ref-wrap">
      <div class="vertical-decor vertical-decor--end" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Who We Are</h2>
          <p class="ref-section-subtitle">Hedayat Educational Foundation was established to strengthen sound knowledge and build well-grounded awareness that helps individuals and communities respond thoughtfully to intellectual and values-based challenges.</p>
        </div>

        <div class="ref-card report-about-card p-4 p-md-5 reveal-on-scroll">
          <div class="row g-4 align-items-center">
            <div class="col-md-5">
              <div class="p-4 rounded-3" style="background-color:var(--soft-sage);">
                <div class="d-flex flex-column align-items-center text-center">
                  <i class="bi bi-patch-check-fill display-5 mb-3" style="color:var(--primary);" aria-hidden="true"></i>
                  <h3 class="fw-bold" style="color: var(--primary);">Registered Educational Foundation</h3>
                  <p class="mb-0" style="color:var(--text-card-muted);">We combine authentic knowledge with contemporary, engaging methods to create meaningful and sustainable impact.</p>
                </div>
              </div>
            </div>
            <div class="col-md-7">
              <h4 class="mb-3" style="color: var(--primary);">Our mission to deepen awareness</h4>
              <p class="mb-3" style="color:var(--text-card-muted);">We work to strengthen reliable knowledge and build well-grounded awareness that protects individuals and communities from misleading intellectual and values-based influences through a balance of academic authenticity and contemporary educational methods.</p>
              <p class="mb-0" style="color:var(--text-card-muted);">We believe that deep awareness is a first line of protection for national and Islamic identity, and that investing in sound understanding is an investment in the future of society.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="vision" class="ref-wrap">
      <div class="vertical-decor vertical-decor--start" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Our Vision & Mission</h2>
          <p class="ref-section-subtitle">The direction that guides our plans and programs</p>
        </div>
        <div class="ref-grid-2 report-grid-vision">
          <div id="vision-item-en" class="ref-card ref-feature reveal-on-scroll">
            <div class="icon"><i class="bi bi-award-fill" aria-hidden="true"></i></div>
            <h3>Our Vision</h3>
            <p>A trusted and leading foundation specialized in providing reliable knowledge that supports the nation’s higher values and contributes to a generation that is aware, confident in its identity and grounded in its values.</p>
          </div>
          <div id="mission-item-en" class="ref-card ref-feature reveal-on-scroll">
            <div class="icon"><i class="bi bi-compass-fill" aria-hidden="true"></i></div>
            <h3>Our Mission</h3>
            <p>A beacon of guidance that deepens community awareness and shares reliable knowledge through purposeful programs, qualified expertise and contemporary, accessible and engaging educational methods.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="goals" class="ref-wrap">
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Our Strategic Goals</h2>
          <p class="ref-section-subtitle">Clear areas of work that support our long-term vision</p>
        </div>
        <div class="ref-grid-4 report-grid-goals">
          {goals.map((item) => (
            <div class="ref-card ref-feature reveal-on-scroll">
              <div class="icon"><i class={item.icon} aria-hidden="true"></i></div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="values" class="ref-wrap">
      <div class="vertical-decor vertical-decor--end" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Our Core Values</h2>
          <p class="ref-section-subtitle">Principles that guide our decisions, programs and partnerships</p>
        </div>
        <div class="ref-grid-4 report-grid-values">
          {values.map((item) => (
            <div class="ref-card ref-feature reveal-on-scroll">
              <div class="icon"><i class={item.icon} aria-hidden="true"></i></div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="programs" class="ref-wrap institutional-info-section">
      <div class="vertical-decor vertical-decor--start" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Programs & Initiatives</h2>
          <p class="ref-section-subtitle">A dedicated space for presenting the Foundation’s educational programs and initiatives clearly and as they are updated.</p>
        </div>
        <article class="ref-card institutional-info-card reveal-on-scroll">
          <div class="institutional-info-icon"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></div>
          <div class="institutional-info-copy">
            <h3>Purposeful Educational Programs</h3>
            <p>The Foundation develops educational programs using contemporary, accessible and engaging methods aligned with its mission and objectives.</p>
          </div>
          <a class="institutional-info-action" href="#contact">Ask about programs</a>
        </article>
      </div>
    </section>

    <section id="partners" class="ref-wrap institutional-info-section">
      <div class="vertical-decor vertical-decor--end" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Partnerships</h2>
          <p class="ref-section-subtitle">We build institutional collaboration that supports program quality and strengthens community impact.</p>
        </div>
        <article class="ref-card institutional-info-card reveal-on-scroll">
          <div class="institutional-info-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></div>
          <div class="institutional-info-copy">
            <h3>Institutional Partnerships</h3>
            <p>For partnership and collaboration opportunities with Hedayat Educational Foundation, please use the official contact channels on this website.</p>
          </div>
          <a class="institutional-info-action" href="#contact">Request a partnership</a>
        </article>
      </div>
    </section>

    <section id="governance" class="ref-wrap en-governance-home">
      <div class="vertical-decor vertical-decor--start" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Governance & Official Documents</h2>
          <p class="ref-section-subtitle">Key official documents are provided in their approved Arabic versions.</p>
        </div>
        <div class="ref-grid-3 en-doc-grid">
          <a class="ref-card en-doc-card reveal-on-scroll" href="/organization-license.pdf" target="_blank" rel="noopener noreferrer">
            <i class="bi bi-patch-check" aria-hidden="true"></i><div><h3>Organization License</h3><p>Official non-profit organization license certificate.</p></div>
          </a>
          <a class="ref-card en-doc-card reveal-on-scroll" href="/basic-regulation.pdf" target="_blank" rel="noopener noreferrer">
            <i class="bi bi-journal-text" aria-hidden="true"></i><div><h3>Basic Regulation</h3><p>Foundation establishment, objectives and governance framework.</p></div>
          </a>
          <a class="ref-card en-doc-card reveal-on-scroll" href="/governance/">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i><div><h3>Governance Center</h3><p>License, regulation, approved policies and publication status.</p></div>
          </a>
        </div>
      </div>
    </section>

    <section id="contact" class="ref-wrap">
      <div class="vertical-decor vertical-decor--end" aria-hidden="true"></div>
      <div class="ref-section">
        <div class="ref-section-header">
          <h2 class="ref-section-title">Contact Us</h2>
          <p class="ref-section-subtitle">We welcome inquiries, suggestions, partnership requests and questions about the Foundation’s programs.</p>
        </div>

        <div class="contact-container report-contact">
          <div class="contact-form reveal-on-scroll">
            <form id="contact-form-en" name="contact-en" method="POST" action="/api/contact">
              <input type="hidden" name="lang" value="en" />
              <input class="form-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <div class="form-group">
                <label class="form-label" for="name-en">Full name</label>
                <input class="form-input" id="name-en" name="name" type="text" autocomplete="name" maxlength="120" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="email-en">Email address</label>
                <input class="form-input" id="email-en" name="email" type="email" autocomplete="email" maxlength="254" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="subject-en">Subject</label>
                <input class="form-input" id="subject-en" name="subject" type="text" maxlength="180" />
              </div>
              <div class="form-group">
                <label class="form-label" for="message-en">Message</label>
                <textarea class="form-textarea" id="message-en" name="message" maxlength="5000" required></textarea>
              </div>
              <button type="submit" class="btn-form-submit">Send message</button>
              <p class="form-privacy-note">Submitted information is used only to contact you and respond to your inquiry. <a href="/privacy/">Privacy Policy</a></p>
              <div id="form-status-en" class="form-status mt-2" role="status" aria-live="polite" aria-atomic="true" style="font-size:0.85rem;"></div>
            </form>
          </div>

          <div class="contact-info">
            <div class="contact-item reveal-on-scroll">
              <div class="contact-icon"><i class="bi bi-envelope" aria-hidden="true"></i></div>
              <div class="contact-details"><h3>Email</h3><p><a class="contact-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p></div>
            </div>
            <div class="contact-item reveal-on-scroll">
              <div class="contact-icon"><i class="bi bi-telephone" aria-hidden="true"></i></div>
              <div class="contact-details"><h3>Phone / WhatsApp</h3><p><a class="contact-link" href={`tel:${waDigits ? `+${waDigits}` : site.contact.phone}`}>{site.contact.phone}</a></p></div>
            </div>
            <div class="contact-item reveal-on-scroll">
              <div class="contact-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></div>
              <div class="contact-details">
                <h3>Address</h3><p>Jeddah, Saudi Arabia</p>
                {site.contact.locationUrl && <a class="contact-action-link" href={site.contact.locationUrl} target="_blank" rel="noopener"><i class="bi bi-map" aria-hidden="true"></i> Open location on map</a>}
              </div>
            </div>
            {site.contact.social?.length > 0 && (
              <div class="contact-item contact-social-item reveal-on-scroll">
                <div class="contact-icon"><i class="bi bi-share" aria-hidden="true"></i></div>
                <div class="contact-details social-contact-details">
                  <h3>Official social media</h3>
                  <p class="social-username" dir="ltr">@{site.contact.socialUsername}</p>
                  <div class="official-social-links" aria-label="Hedayat official social media accounts">
                    {site.contact.social.map((account) => (
                      <a class="official-social-link" href={account.url} target="_blank" rel="noopener noreferrer" aria-label={`Hedayat on ${account.name}`} title={`Hedayat on ${account.name}`}>
                        {account.name === "X" ? <span class="social-x-mark" aria-hidden="true">X</span> : <i class={`bi ${account.icon}`} aria-hidden="true"></i>}
                        <span>{account.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="official-trust-bar" aria-label="Official foundation information">
      <div class="official-trust-inner">
        <div class="trust-item trust-item--type">
          <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
          <div><span>Organization type</span><strong>Licensed Non-profit Foundation</strong></div>
        </div>
        <div class="trust-item">
          <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
          <div><span>License number</span><strong>{institution.licenseNumber}</strong></div>
        </div>
        <div class="trust-item">
          <i class="bi bi-building" aria-hidden="true"></i>
          <div><span>Unified National Number</span><strong>{institution.unifiedNationalNumber}</strong></div>
        </div>
        <div class="trust-item">
          <i class="bi bi-mortarboard-fill" aria-hidden="true"></i>
          <div><span>Supervising authority</span><strong>Ministry of Education</strong></div>
        </div>
        <a class="trust-verify" href={institution.verifyUrl} target="_blank" rel="noopener noreferrer">
          <i class="bi bi-patch-check" aria-hidden="true"></i>
          <span>Verify license</span>
          <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <img src="/identity-grid.png" alt="" aria-hidden="true" class="footer-watermark footer-watermark--start" />
    <img src="/identity-grid.png" alt="" aria-hidden="true" class="footer-watermark footer-watermark--end" />
    <div class="footer-top">
      <div class="footer-logos">
        <img src={site.assets.logoNav} alt="Hedayat Educational Foundation logo" class="official-logo official-logo-footer" style="display:block; width:min(72vw,320px); height:auto; max-width:100%; object-fit:contain; background:transparent !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; padding:0 !important; margin:0 !important;" />
        <img src={site.assets.nationalCenterLogo} alt="National Center for Non-Profit Sector logo" class="footer-logo national-center-footer-logo" width="733" height="340" />
      </div>
      <p class="footer-license">Licensed by the National Center for Non-Profit Sector — License No. {institution.licenseNumber}</p>
      <nav class="footer-links" aria-label="Footer links">
        <a href="/en/#home">Home</a><span aria-hidden="true">•</span>
        <a href="#governance">Governance</a><span aria-hidden="true">•</span>
        <a href="/transparency/">Transparency</a><span aria-hidden="true">•</span>
        <a href="/accessibility/">Accessibility</a><span aria-hidden="true">•</span>
        <a href="/en/participation/">Beneficiary Participation</a><span aria-hidden="true">•</span>
        <a href="#contact">Contact</a><span aria-hidden="true">•</span>
        <a href="/privacy/">Privacy</a><span aria-hidden="true">•</span>
        <a href="/" lang="ar" dir="rtl">العربية</a>
      </nav>
    </div>
    <hr class="footer-divider" />
    <div class="footer-bottom"><div class="footer-copy">All rights reserved © {new Date().getFullYear()} Hedayat</div></div>
  </footer>

  <style is:inline>
    :global(html[lang="en"] body){direction:ltr;text-align:left;font-family:Arial,"Helvetica Neue",sans-serif}
    :global(html[lang="en"] .ref-section-title),
    :global(html[lang="en"] .hero-title),
    :global(html[lang="en"] .ref-feature h3),
    :global(html[lang="en"] .institutional-info-copy h3){font-family:Georgia,"Times New Roman",serif;font-feature-settings:normal;-webkit-text-stroke:0}
    :global(html[lang="en"] .report-grid-goals),
    :global(html[lang="en"] .report-grid-values){direction:ltr}
    :global(html[lang="en"] .contact-details),
    :global(html[lang="en"] .institutional-info-copy){text-align:left}
    :global(html[lang="en"] .en-doc-grid){max-width:920px;margin-inline:auto}
    :global(html[lang="en"] .en-doc-card){padding:22px;display:flex;align-items:flex-start;gap:14px;text-decoration:none;color:var(--text-card-main)}
    :global(html[lang="en"] .en-doc-card>i){font-size:1.45rem;color:var(--brand-teal);margin-top:2px}
    :global(html[lang="en"] .en-doc-card h3){margin:0 0 7px;font-size:1rem;font-weight:900;color:var(--text-card-main)}
    :global(html[lang="en"] .en-doc-card p){margin:0;color:var(--text-card-muted);font-size:.82rem;line-height:1.7}
    @media(max-width:991.98px){:global(html[lang="en"] .hdr .navbar-collapse){text-align:left}}
  </style>

  <script is:inline>
    const hdr = document.querySelector('.hdr');
    function handleScroll() {
      if (!hdr) return;
      if (window.scrollY > 60) hdr.classList.add('scrolled');
      else hdr.classList.remove('scrolled');
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('load', handleScroll);

    window.addEventListener('DOMContentLoaded', () => {
      const revealEls = document.querySelectorAll('.reveal-on-scroll');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach(el => observer.observe(el));
      } else {
        revealEls.forEach(el => el.classList.add('is-visible'));
      }

      const contactForm = document.getElementById('contact-form-en');
      const formStatus = document.getElementById('form-status-en');
      if (contactForm && formStatus) {
        const params = new URLSearchParams(window.location.search);
        if (params.get('sent') === '1') {
          formStatus.className = 'form-status is-success';
          formStatus.textContent = 'Your message has been received successfully.';
        }
        contactForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!contactForm.reportValidity()) return;
          const submitButton = contactForm.querySelector('button[type="submit"]');
          const originalLabel = submitButton?.textContent || 'Send message';
          if (submitButton) { submitButton.disabled = true; submitButton.textContent = 'Sending…'; }
          formStatus.className = 'form-status is-pending';
          formStatus.textContent = 'Sending your message…';
          try {
            const body = new URLSearchParams(new FormData(contactForm));
            const response = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'Accept': 'application/json' },
              body: body.toString()
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok || !data.ok) throw new Error('Unable to send the message right now. Please try again.');
            contactForm.reset();
            formStatus.className = 'form-status is-success';
            formStatus.textContent = 'Your message has been received successfully.';
          } catch (error) {
            formStatus.className = 'form-status is-error';
            formStatus.textContent = error?.message || 'Unable to send the message right now. Please try again.';
          } finally {
            if (submitButton) { submitButton.disabled = false; submitButton.textContent = originalLabel; }
          }
        });
      }

      const navMain = document.getElementById('navMainEn');
      const navToggler = document.querySelector('.navbar-toggler');
      if (navMain && navToggler) {
        navMain.querySelectorAll('a.nav-link, a.dropdown-item').forEach(link => {
          link.addEventListener('click', () => {
            const isTogglerVisible = window.getComputedStyle(navToggler).display !== 'none';
            const isExpanded = navToggler.getAttribute('aria-expanded') === 'true';
            if (isTogglerVisible && isExpanded) navToggler.click();
          });
        });
      }
    });
  </script>
</BaseLayout>
