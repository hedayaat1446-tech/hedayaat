---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../content/site-en.json";

const waDigits = (site.contact.phone || "").replace(/\D/g, "");
const meta = {
  ...site.meta,
  title: "Hedayat Educational Foundation",
  description: "Official website of Hedayat Educational Foundation, a licensed non-profit educational foundation in Jeddah that builds lasting awareness through purposeful programs and reliable knowledge.",
  locale: "en_SA",
  siteName: "Hedayat Educational Foundation"
};

const pillars = [
  { title: "Our Vision", icon: "bi bi-eye", text: "Lasting awareness that protects individuals and society from intellectual and moral deviation." },
  { title: "Our Mission", icon: "bi bi-compass", text: "To provide reliable scholarly content and purposeful programs that build conviction and strengthen identity and values." },
  { title: "Our Approach", icon: "bi bi-diagram-3", text: "We balance scholarly authenticity with contemporary teaching methods, and design our programs to leave a lasting impact." }
];
const goals = [
  { title: "Empowering the Next Generation", icon: "bi bi-shield-check", text: "Enabling girls to distinguish sound knowledge from misinformation and to build strong intellectual and moral resilience." },
  { title: "Building Educational Capacity", icon: "bi bi-mortarboard-fill", text: "Preparing educators who deepen students’ convictions rather than merely passing on information." },
  { title: "Keeping Pace with Current Issues", icon: "bi bi-lightning-charge-fill", text: "Equipping teachers to connect the curriculum with contemporary developments and current intellectual questions." },
  { title: "Financial Sustainability", icon: "bi bi-cash-coin", text: "Achieving financial self-sufficiency to sustain our programs and broaden their impact on society." }
];
const values = [
  { title: "Quality", icon: "bi bi-star-fill", text: "High-standard services and outcomes that meet beneficiaries’ expectations." },
  { title: "Transparency & Credibility", icon: "bi bi-patch-check-fill", text: "Clarity, honesty and disclosure of relevant information and decisions to build trust." },
  { title: "Collaboration", icon: "bi bi-people-fill", text: "Teamwork and combined efforts toward shared goals." },
  { title: "Innovation", icon: "bi bi-lightbulb-fill", text: "Creative ideas and solutions that raise quality and meet real needs." },
  { title: "Flexibility", icon: "bi bi-arrow-repeat", text: "Adapting to change while staying true to our principles." }
];
const tracks = [
  { title: "Girls’ Track", audience: "Girls and female students", icon: "bi bi-stars", text: "Programs that build intellectual and moral resilience and develop the skill of verifying information." },
  { title: "Educators’ Track", audience: "Female teachers and educators", icon: "bi bi-mortarboard", text: "Programs that prepare educators to deepen convictions and connect the curriculum with contemporary issues." }
];
---

<BaseLayout meta={meta} lang="en" dir="ltr" skipLabel="Skip to main content" accessibilityLabel="Accessibility tools">
  <link slot="head" rel="preload" as="image" href="/hero-lighthouse-photo.webp" type="image/webp" fetchpriority="high" />

  <main id="main-content">
    <section id="home" class="hero-section hero-photo">
      <div class="hero-photo-img" aria-hidden="true"></div>
      <div class="container hero-photo-inner">
        <div class="hero-photo-copy">
          <span class="hero-eyebrow">Hedayat Educational Foundation</span>
          <h1 class="hero-photo-title">A Beacon of Guidance for Deeper Community Awareness</h1>
          <p class="hero-photo-lead">We provide authentic knowledge that reinforces the nation’s core values, through purposeful programs delivered by qualified specialists using modern, engaging learning methods.</p>
          <div class="hero-photo-actions">
            <a href="#about" class="hp-btn">Discover the Foundation <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            <a href="/en/videos/" class="hp-btn hp-btn--ghost"><i class="bi bi-play-circle" aria-hidden="true"></i> Watch the introductory video</a>
          </div>
        </div>
      </div>
    </section>

    <nav class="qa2 qa2--compact" aria-label="Quick access">
      <a class="qa2-card" href="#about"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-info-circle"></i></span><strong>About Hedayat</strong></a>
      <a class="qa2-card" href="#programs"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-book-half"></i></span><strong>Programs</strong></a>
      <a class="qa2-card" href="/en/governance/"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-bank2"></i></span><strong>Governance &amp; Transparency</strong></a>
      <a class="qa2-card" href="/en/participation/"><span class="qa2-icon" aria-hidden="true"><i class="bi bi-people"></i></span><strong>Beneficiary Participation</strong></a>
    </nav>

    <section id="about" class="home-section">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>Who We Are</h2>
          <p>A licensed non-profit educational foundation, established in Jeddah in 1446 AH to strengthen awareness among girls and educators.</p>
        </header>
        <div class="pillars">
          {pillars.map((x, i) => (
            <article class="pillar reveal-on-scroll" style={`--d:${i * 90}ms`}>
              <span class="pillar-icon" aria-hidden="true"><i class={x.icon}></i></span>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="goals" class="home-section home-section--tint">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>Our Strategic Goals</h2>
          <p>Four goals that guide our programs and decisions.</p>
        </header>
        <ol class="goals-grid">
          {goals.map((g, i) => (
            <li class="goal-card reveal-on-scroll" style={`--d:${i * 90}ms`}>
              <span class="goal-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="goal-icon" aria-hidden="true"><i class={g.icon}></i></span>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="values" class="home-section">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>Our Values</h2>
          <p>Principles we uphold in everything we do.</p>
        </header>
        <ul class="values-grid">
          {values.map((v, i) => (
            <li class="value-card reveal-on-scroll" style={`--d:${i * 70}ms`} tabindex="0">
              <span class="value-icon" aria-hidden="true"><i class={v.icon}></i></span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="programs" class="home-section home-section--tint">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>Programs &amp; Partnerships</h2>
          <p>Two clear learning tracks, and partnerships that extend our impact.</p>
        </header>
        <div class="tracks">
          {tracks.map((t, i) => (
            <article class="track-card reveal-on-scroll" style={`--d:${i * 100}ms`}>
              <span class="track-icon" aria-hidden="true"><i class={t.icon}></i></span>
              <div>
                <h3>{t.title}</h3>
                <p class="track-audience"><i class="bi bi-person-check" aria-hidden="true"></i> Target group: {t.audience}</p>
                <p>{t.text}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="pp-actions reveal-on-scroll">
          <a class="hp-btn" href="#contact" data-subject="Program inquiry">Ask about our programs</a>
        </div>
        <article id="partners" class="partner-strip reveal-on-scroll">
          <span class="track-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
          <div>
            <h3>Institutional Partnerships</h3>
            <p>We welcome collaboration with educational and community organizations to design joint programs.</p>
          </div>
          <a class="hp-btn hp-btn--ghost" href="#contact" data-subject="Partnership request">Request a partnership</a>
        </article>
      </div>
    </section>

    <section id="contact" class="home-section">
      <div class="home-section-inner">
        <header class="home-head reveal-on-scroll">
          <h2>Contact Us</h2>
          <p>We welcome your questions, suggestions and partnership requests.</p>
        </header>

        <div class="contact-split">
          <div class="contact-form reveal-on-scroll">
            <form id="contact-form-en" name="contact-en" method="POST" action="/api/contact">
              <input type="hidden" name="lang" value="en" />
              <input class="form-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <div class="form-row-2">
                <div class="form-group">
                  <label class="form-label" for="name-en">Full name</label>
                  <input class="form-input" id="name-en" name="name" type="text" autocomplete="name" maxlength="120" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="email-en">Email address</label>
                  <input class="form-input" id="email-en" name="email" type="email" autocomplete="email" maxlength="254" required />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="subject-en">Subject</label>
                <input class="form-input" id="subject-en" name="subject" type="text" maxlength="180" />
              </div>
              <div class="form-group">
                <label class="form-label" for="message-en">Message</label>
                <textarea class="form-textarea" id="message-en" name="message" maxlength="5000" required></textarea>
              </div>
              <label class="form-consent">
                <input type="checkbox" name="privacyAccepted" value="yes" required />
                <span>I have read the <a href="/en/privacy/">Privacy Policy</a> and agree that my information will be used only to contact me and respond to my inquiry.</span>
              </label>
              <button type="submit" class="btn-form-submit">Send message</button>
              <div id="form-status-en" class="form-status mt-2" role="status" aria-live="polite" aria-atomic="true"></div>
            </form>
          </div>

          <aside class="contact-side reveal-on-scroll" aria-label="Contact details">
            <a class="contact-line" href={`mailto:${site.contact.email}`}>
              <span class="contact-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
              <span><small>Email</small><strong>{site.contact.email}</strong></span>
            </a>
            <a class="contact-line" href={`tel:+${waDigits}`}>
              <span class="contact-icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
              <span><small>Phone / WhatsApp</small><strong dir="ltr">{site.contact.phone}</strong></span>
            </a>
            <a class="contact-line" href={site.contact.locationUrl || "#"} target="_blank" rel="noopener">
              <span class="contact-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
              <span><small>Address</small><strong>Jeddah, Saudi Arabia</strong><em>Open in Maps</em></span>
            </a>
            {site.contact.social?.length > 0 && (
              <div class="contact-social">
                <small>Official social media <span dir="ltr">@{site.contact.socialUsername}</span></small>
                <div class="official-social-links" aria-label="Hedayat official social media accounts">
                  {site.contact.social.map((account) => (
                    <a class="official-social-link" href={account.url} target="_blank" rel="noopener noreferrer" aria-label={`Hedayat on ${account.name}`} title={account.name}>
                      {account.name === "X" ? <span class="social-x-mark" aria-hidden="true">X</span> : <i class={`bi ${account.icon}`} aria-hidden="true"></i>}
                      <span>{account.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </aside>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      document.querySelectorAll('[data-subject]').forEach((a) => a.addEventListener('click', () => {
        const subject = document.getElementById('subject-en');
        if (subject && !subject.value) subject.value = a.dataset.subject;
        setTimeout(() => document.getElementById('name-en')?.focus({ preventScroll: true }), 600);
      }));

      const contactForm = document.getElementById('contact-form-en');
      const formStatus = document.getElementById('form-status-en');
      if (!contactForm || !formStatus) return;
      const params = new URLSearchParams(window.location.search);
      if (params.get('sent') === '1') { formStatus.className = 'form-status is-success'; formStatus.textContent = 'Your message has been received.'; }
      contactForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!contactForm.reportValidity()) return;
        const submitButton = contactForm.querySelector('button[type="submit"]');
        const originalLabel = submitButton?.textContent || 'Send message';
        if (submitButton) { submitButton.disabled = true; submitButton.textContent = 'Sending…'; }
        formStatus.className = 'form-status is-pending';
        formStatus.textContent = 'Sending your message…';
        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'Accept': 'application/json' },
            body: new URLSearchParams(new FormData(contactForm)).toString()
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || 'We could not send your message right now. Please try again.');
          contactForm.reset();
          formStatus.className = 'form-status is-success';
          formStatus.textContent = 'Your message has been received. Thank you.';
        } catch (error) {
          formStatus.className = 'form-status is-error';
          formStatus.textContent = error?.message || 'We could not send your message right now. Please try again.';
        } finally {
          if (submitButton) { submitButton.disabled = false; submitButton.textContent = originalLabel; }
        }
      });
    })();
  </script>
</BaseLayout>
