---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../content/site.json";
const meta = {
  ...site.meta,
  title: "Beneficiary Participation & Satisfaction | Hedayat Educational Foundation",
  description: "Beneficiary participation center for satisfaction measurement, suggestions, inquiries, feedback and request tracking with a reference number.",
  locale: "en_SA",
  siteName: "Hedayat Educational Foundation"
};
---
<BaseLayout meta={meta} lang="en" dir="ltr" skipLabel="Skip to main content" accessibilityLabel="Accessibility tools">
  <main id="main-content" class="participation-page">
    <header class="participation-header">
      <div class="participation-header-inner">
        <a href="/en/" aria-label="Back to English home"><img src={site.assets.logoNav} alt="Hedayat Educational Foundation logo" /></a>
        <div class="participation-header-actions"><a href="/participation/" lang="ar" dir="rtl">العربية</a><a href="/en/"><i class="bi bi-house-door" aria-hidden="true"></i><span>Home</span></a></div>
      </div>
    </header>

    <section class="participation-hero" aria-labelledby="participation-title"><div class="participation-shell"><span class="participation-kicker"><i class="bi bi-people" aria-hidden="true"></i> Your voice supports improvement</span><h1 id="participation-title">Beneficiary Participation & Satisfaction</h1><p>A single place to rate your experience, send suggestions or inquiries, and track submitted requests using a clear reference number.</p><div class="participation-hero-actions"><a href="#satisfaction" class="participation-primary"><i class="bi bi-star" aria-hidden="true"></i> Satisfaction survey</a><a href="#request" class="participation-secondary"><i class="bi bi-chat-square-text" aria-hidden="true"></i> Submit feedback</a><a href="#track" class="participation-secondary"><i class="bi bi-search" aria-hidden="true"></i> Track request</a></div></div></section>

    <section class="participation-intro" aria-label="Participation options"><article><i class="bi bi-bar-chart-line" aria-hidden="true"></i><h2>Satisfaction measurement</h2><p>Rate your experience from 1 to 5 and help us identify improvement opportunities.</p></article><article><i class="bi bi-lightbulb" aria-hidden="true"></i><h2>Suggestion or inquiry</h2><p>Share an idea, feedback, inquiry or a technical issue through one structured form.</p></article><article><i class="bi bi-journal-check" aria-hidden="true"></i><h2>Clear tracking</h2><p>Each submission receives a reference number that can be used to check its status without exposing its content.</p></article></section>

    <section id="satisfaction" class="participation-section" aria-labelledby="satisfaction-title"><div class="participation-section-head"><span>Satisfaction indicator</span><h2 id="satisfaction-title">How would you rate your website experience?</h2><p>Select a score from 1 to 5. This form does not ask for your name or email address.</p></div><form id="satisfactionForm" class="participation-card participation-form" novalidate><fieldset class="score-fieldset"><legend>Satisfaction level</legend><div class="score-options" role="radiogroup" aria-label="Satisfaction score from 1 to 5"><label><input type="radio" name="score" value="1" required /><span><strong>1</strong><small>Very low</small></span></label><label><input type="radio" name="score" value="2" /><span><strong>2</strong><small>Low</small></span></label><label><input type="radio" name="score" value="3" /><span><strong>3</strong><small>Fair</small></span></label><label><input type="radio" name="score" value="4" /><span><strong>4</strong><small>Good</small></span></label><label><input type="radio" name="score" value="5" /><span><strong>5</strong><small>Excellent</small></span></label></div></fieldset><div class="form-grid"><label class="field"><span>Area being rated</span><select name="reason"><option value="overall">Overall experience</option><option value="clarity">Content clarity</option><option value="ease">Ease of use</option><option value="content">Content quality</option><option value="accessibility">Accessibility</option><option value="speed">Finding information quickly</option><option value="other">Other</option></select></label><label class="field field-full"><span>Additional comment <small>(optional)</small></span><textarea name="comment" maxlength="1500" rows="4" placeholder="Share a brief comment..."></textarea></label></div><input class="participation-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" /><div class="form-submit-row"><button type="submit" class="participation-submit"><i class="bi bi-send" aria-hidden="true"></i> Submit rating</button><div id="satisfactionStatus" class="form-status" role="status" aria-live="polite"></div></div></form></section>

    <section id="request" class="participation-section participation-soft" aria-labelledby="request-title"><div class="participation-section-head"><span>Beneficiary participation</span><h2 id="request-title">Send a suggestion or inquiry</h2><p>You will receive a reference number after submission. Contact details are only requested if you choose to receive a response.</p></div><form id="participationForm" class="participation-card participation-form" novalidate><div class="form-grid"><label class="field"><span>Submission type *</span><select name="type" required><option value="">Select type</option><option value="suggestion">Suggestion</option><option value="complaint">Feedback / complaint</option><option value="inquiry">Inquiry</option><option value="technical">Technical issue</option></select></label><label class="field"><span>Category *</span><select name="category" required><option value="">Select category</option><option value="programs">Programs & initiatives</option><option value="governance">Governance & documents</option><option value="website">Website</option><option value="accessibility">Accessibility</option><option value="general">General</option></select></label><label class="field field-full"><span>Subject *</span><input name="subject" maxlength="180" required placeholder="A short and clear subject" /></label><label class="field field-full"><span>Details *</span><textarea name="details" maxlength="4000" rows="6" required placeholder="Provide the details needed to understand your submission..."></textarea></label></div><label class="response-toggle"><input id="responseRequested" type="checkbox" name="responseRequested" /><span><strong>I would like a response</strong><small>An email field will appear when this option is selected.</small></span></label><div id="responseFields" class="form-grid response-fields" hidden><label class="field"><span>Name <small>(optional)</small></span><input name="name" maxlength="120" autocomplete="name" /></label><label class="field"><span>Email *</span><input name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" /></label></div><label class="privacy-check"><input type="checkbox" name="privacyAccepted" required /><span>I have read the <a href="/privacy/" target="_blank" rel="noopener">Privacy Policy</a> and agree to the processing of the information I provide for receiving and following up on this submission.</span></label><input class="participation-honeypot" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" /><div class="form-submit-row"><button type="submit" class="participation-submit"><i class="bi bi-send" aria-hidden="true"></i> Submit</button><div id="participationStatus" class="form-status" role="status" aria-live="polite"></div></div><div id="referenceBox" class="reference-box" hidden><div><span>Reference number</span><strong id="referenceValue"></strong><small>Keep this number to track your request.</small></div><button id="copyReference" type="button"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy</button></div></form></section>

    <section id="track" class="participation-section" aria-labelledby="track-title"><div class="participation-section-head"><span>Request tracking</span><h2 id="track-title">Check your submission status</h2><p>Enter the reference number shown after submission. The content of your submission and contact details are never displayed in the tracking result.</p></div><form id="trackForm" class="participation-card track-form" novalidate><label class="field"><span>Reference number</span><input id="trackReference" name="reference" maxlength="40" autocomplete="off" placeholder="HDY-2026-XXXXXXXXXX" required /></label><button type="submit" class="participation-submit"><i class="bi bi-search" aria-hidden="true"></i> Check status</button><div id="trackStatus" class="form-status track-status" role="status" aria-live="polite"></div><div id="trackResult" class="track-result" hidden></div></form></section>

    <section class="participation-note" aria-label="Privacy note"><i class="bi bi-shield-check" aria-hidden="true"></i><div><h2>Your privacy matters</h2><p>The satisfaction survey does not request personal information. In the participation form, email is requested only when you ask for a response. Please avoid entering personal or sensitive information that is not necessary for your submission.</p></div></section>
  </main>

  <script is:inline>
    (() => {
      const qs=(s,r=document)=>r.querySelector(s); const setStatus=(e,t,s='')=>{e.textContent=t||'';e.dataset.state=s};
      const toggle=qs('#responseRequested'), fields=qs('#responseFields'), email=qs('input[name="email"]',fields);
      toggle?.addEventListener('change',()=>{fields.hidden=!toggle.checked;email.required=toggle.checked;if(!toggle.checked){qs('input[name="name"]',fields).value='';email.value='';}});
      const sf=qs('#satisfactionForm'); sf?.addEventListener('submit',async e=>{e.preventDefault();const st=qs('#satisfactionStatus'),btn=qs('button[type="submit"]',sf),fd=new FormData(sf);if(!fd.get('score')){setStatus(st,'Please select a satisfaction score first.','error');sf.querySelector('input[name="score"]')?.focus();return;}btn.disabled=true;setStatus(st,'Submitting...','loading');try{const r=await fetch('/api/satisfaction',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({score:Number(fd.get('score')),reason:String(fd.get('reason')||'overall'),comment:String(fd.get('comment')||''),'bot-field':String(fd.get('bot-field')||''),lang:'en',page:location.pathname})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||'Could not submit rating.');sf.reset();setStatus(st,d.message||'Thank you. Your rating has been recorded.','success')}catch(x){setStatus(st,x.message||'Could not submit rating.','error')}finally{btn.disabled=false}});
      const pf=qs('#participationForm'); pf?.addEventListener('submit',async e=>{e.preventDefault();const st=qs('#participationStatus'),btn=qs('button[type="submit"]',pf);if(!pf.reportValidity())return;const fd=new FormData(pf);btn.disabled=true;setStatus(st,'Submitting...','loading');qs('#referenceBox').hidden=true;try{const payload={type:String(fd.get('type')||''),category:String(fd.get('category')||''),subject:String(fd.get('subject')||''),details:String(fd.get('details')||''),responseRequested:fd.get('responseRequested')==='on',name:String(fd.get('name')||''),email:String(fd.get('email')||''),privacyAccepted:fd.get('privacyAccepted')==='on','bot-field':String(fd.get('bot-field')||''),lang:'en'};const r=await fetch('/api/participation',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||'Could not submit your request.');pf.reset();fields.hidden=true;email.required=false;setStatus(st,d.message||'Your request has been received.','success');qs('#referenceValue').textContent=d.reference||'';qs('#referenceBox').hidden=!d.reference;qs('#trackReference').value=d.reference||''}catch(x){setStatus(st,x.message||'Could not submit your request.','error')}finally{btn.disabled=false}});
      qs('#copyReference')?.addEventListener('click',async()=>{const v=qs('#referenceValue').textContent.trim();if(!v)return;try{await navigator.clipboard.writeText(v);qs('#copyReference').textContent='Copied';setTimeout(()=>{qs('#copyReference').innerHTML='<i class="bi bi-clipboard" aria-hidden="true"></i> Copy'},1400)}catch{}});
      const labels={received:'Received',in_review:'Under review',resolved:'Resolved',closed:'Closed'},types={suggestion:'Suggestion',complaint:'Feedback / complaint',inquiry:'Inquiry',technical:'Technical issue'};
      qs('#trackForm')?.addEventListener('submit',async e=>{e.preventDefault();const out=qs('#trackStatus'),result=qs('#trackResult'),ref=qs('#trackReference').value.trim().toUpperCase();result.hidden=true;setStatus(out,'Checking...','loading');try{const r=await fetch(`/api/participation/status?reference=${encodeURIComponent(ref)}&lang=en`,{headers:{Accept:'application/json'},credentials:'same-origin'}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||'Could not check status.');const x=d.data||{},u=new Date(x.statusUpdatedAt);result.innerHTML='<div><span>Reference</span><strong class="track-ref"></strong></div><div><span>Type</span><strong class="track-type"></strong></div><div><span>Status</span><strong class="track-state"></strong></div><div><span>Last update</span><strong class="track-date"></strong></div>';qs('.track-ref',result).textContent=x.reference||ref;qs('.track-type',result).textContent=types[x.type]||'—';qs('.track-state',result).textContent=labels[x.status]||x.status||'—';qs('.track-date',result).textContent=Number.isNaN(u.getTime())?'—':u.toLocaleString('en-SA');result.hidden=false;setStatus(out,'Request found.','success')}catch(x){setStatus(out,x.message||'Could not check status.','error')}});
    })();
  </script>

  <style>
    :global(body){margin:0;background:#f7f8f5;color:#35433a}.participation-page{min-height:100vh;font-family:Arial,sans-serif}.participation-header{position:sticky;top:0;z-index:30;background:rgba(255,255,255,.97);border-bottom:1px solid rgba(100,117,80,.14);backdrop-filter:blur(12px)}.participation-header-inner{max-width:1160px;margin:auto;padding:12px 22px;display:flex;justify-content:space-between;align-items:center;gap:15px}.participation-header img{display:block;width:180px;max-width:44vw;height:auto}.participation-header-actions{display:flex;gap:8px}.participation-header-actions a{display:inline-flex;align-items:center;gap:7px;padding:9px 12px;border:1px solid rgba(100,117,80,.2);border-radius:10px;color:#526441;background:#fff;font-weight:800;text-decoration:none}.participation-hero{padding:78px 20px 62px;text-align:center;background:radial-gradient(circle at 10% 20%,rgba(190,174,89,.12),transparent 28%),linear-gradient(135deg,#f0f4ea,#fff 58%,#eaf3f3)}.participation-shell{max-width:880px;margin:auto}.participation-kicker{display:inline-flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;background:#eaf0e3;color:#526441;font-weight:800}.participation-hero h1{font-size:clamp(2.15rem,5vw,3.8rem);margin:18px 0 13px;color:#30483e;font-weight:900}.participation-hero p{max-width:780px;margin:auto;color:#637168;line-height:1.8;font-size:1.05rem}.participation-hero-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:24px}.participation-hero-actions a{display:inline-flex;align-items:center;gap:8px;padding:11px 17px;border-radius:11px;text-decoration:none;font-weight:800}.participation-primary{background:#315f70;color:#fff}.participation-secondary{background:#fff;color:#315f70;border:1px solid rgba(49,95,112,.2)}.participation-intro{max-width:1160px;margin:-25px auto 0;padding:0 20px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;position:relative;z-index:2}.participation-intro article{background:#fff;border:1px solid rgba(100,117,80,.13);border-radius:18px;padding:24px;box-shadow:0 13px 32px rgba(55,73,63,.07)}.participation-intro article>i{width:50px;height:50px;display:grid;place-items:center;border-radius:14px;background:#edf3e8;color:#526441;font-size:23px}.participation-intro h2{font-size:1.12rem;margin:14px 0 6px;color:#344c40}.participation-intro p{margin:0;color:#69766e;line-height:1.7;font-size:.94rem}.participation-section{max-width:1160px;margin:auto;padding:70px 20px 10px;scroll-margin-top:90px}.participation-soft{max-width:none;margin-top:55px;padding-top:65px;padding-bottom:65px;background:#f0f4f1}.participation-soft>.participation-section-head,.participation-soft>.participation-card{max-width:1120px;margin-inline:auto}.participation-section-head{text-align:center;margin-bottom:24px}.participation-section-head>span{color:#8a7433;font-weight:800;font-size:.86rem}.participation-section-head h2{margin:5px 0 7px;color:#344c40;font-size:clamp(1.65rem,3vw,2.3rem);font-weight:900}.participation-section-head p{margin:0 auto;max-width:760px;color:#69766e;line-height:1.75}.participation-card{background:#fff;border:1px solid rgba(100,117,80,.14);border-radius:22px;padding:28px;box-shadow:0 14px 36px rgba(55,73,63,.06)}.score-fieldset{border:0;padding:0;margin:0 0 24px}.score-fieldset legend{font-weight:800;color:#3b5045;margin-bottom:10px}.score-options{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.score-options label{cursor:pointer}.score-options input{position:absolute;opacity:0;pointer-events:none}.score-options span{min-height:92px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border:1px solid #d8e2dc;border-radius:15px;background:#fbfcfb;color:#52645b;transition:.18s ease}.score-options strong{font-size:1.6rem;color:#315f70}.score-options small{font-size:.78rem}.score-options input:checked+span{border-color:#315f70;background:#eaf3f3;box-shadow:0 0 0 3px rgba(49,95,112,.08)}.score-options input:focus-visible+span{outline:3px solid #beae59;outline-offset:3px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field-full{grid-column:1/-1}.field>span{font-weight:800;color:#3d5147}.field small{font-weight:500;color:#77847d}.field input,.field select,.field textarea{width:100%;border:1px solid #d2ded7;border-radius:11px;padding:11px 12px;background:#fff;color:#35433a;font:inherit;outline:0}.field textarea{resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:#315f70;box-shadow:0 0 0 3px rgba(49,95,112,.08)}.response-toggle,.privacy-check{display:flex;align-items:flex-start;gap:10px;margin-top:18px}.response-toggle input,.privacy-check input{margin-top:5px;accent-color:#315f70}.response-toggle span{display:grid}.response-toggle strong{color:#3d5147}.response-toggle small{color:#758078}.response-fields{margin-top:16px}.privacy-check span{color:#657168;line-height:1.7}.privacy-check a{color:#315f70;font-weight:800}.participation-honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important}.form-submit-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:22px}.participation-submit{border:0;border-radius:11px;padding:11px 17px;background:#315f70;color:#fff;font:inherit;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer}.participation-submit:disabled{opacity:.6;cursor:wait}.form-status{min-height:26px;font-weight:700;color:#6c7871}.form-status[data-state="success"]{color:#226044}.form-status[data-state="error"]{color:#9b2c2c}.form-status[data-state="loading"]{color:#66777d}.reference-box{margin-top:20px;padding:17px;border-radius:15px;background:#eef5f3;border:1px solid #ccdfda;display:flex;align-items:center;justify-content:space-between;gap:16px}.reference-box[hidden]{display:none}.reference-box div{display:grid;gap:2px}.reference-box span,.reference-box small{color:#64766d}.reference-box strong{direction:ltr;color:#234e5d;font-size:1.2rem;letter-spacing:.03em}.reference-box button{border:1px solid #bfd3cd;background:#fff;color:#315f70;border-radius:9px;padding:9px 12px;font:inherit;font-weight:800;cursor:pointer}.track-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:end;max-width:830px;margin:auto}.track-status,.track-result{grid-column:1/-1}.track-result{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:2px}.track-result[hidden]{display:none}.track-result>div{border:1px solid #dbe4df;border-radius:12px;padding:13px;background:#fafcfb;display:grid;gap:3px}.track-result span{font-size:.78rem;color:#758078}.track-result strong{color:#344c40}.track-ref{direction:ltr}.participation-note{max-width:1120px;margin:58px auto 85px;padding:24px;display:flex;gap:17px;align-items:flex-start;background:#315f70;color:#fff;border-radius:20px}.participation-note>i{width:52px;height:52px;flex:0 0 52px;display:grid;place-items:center;border-radius:14px;background:rgba(255,255,255,.12);font-size:25px}.participation-note h2{margin:0 0 5px;font-size:1.25rem}.participation-note p{margin:0;color:#e8f0f1;line-height:1.75}:global(.a11y-high-contrast) .participation-card,:global(.a11y-high-contrast) .participation-intro article,:global(.a11y-high-contrast) .field input,:global(.a11y-high-contrast) .field select,:global(.a11y-high-contrast) .field textarea{border-color:#222!important;box-shadow:none!important}:global(.a11y-high-contrast) .score-options input:checked+span{background:#111!important;color:#fff!important}@media(max-width:850px){.participation-intro{grid-template-columns:1fr}.track-result{grid-template-columns:1fr 1fr}}@media(max-width:620px){.participation-header-inner{padding:11px 14px}.participation-header img{width:142px}.participation-header-actions a span{display:none}.participation-hero{padding:54px 15px 46px}.participation-intro{margin-top:18px;padding:0 14px}.participation-section{padding:52px 14px 8px}.participation-soft{padding-top:52px;padding-bottom:52px}.participation-card{padding:18px;border-radius:17px}.score-options{grid-template-columns:1fr 1fr 1fr}.form-grid{grid-template-columns:1fr}.field-full{grid-column:auto}.form-submit-row{align-items:stretch}.participation-submit{width:100%}.reference-box{align-items:stretch;flex-direction:column}.track-form{grid-template-columns:1fr}.track-result{grid-template-columns:1fr}.participation-note{margin:48px 14px 70px;flex-direction:column}}
  </style>
</BaseLayout>
