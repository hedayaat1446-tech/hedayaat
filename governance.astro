---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/site.json";

const governance = site.docs.governance;
const meta = {
  ...site.meta,
  title: `${governance.title} | مؤسسة هدايات التعليمية`,
  description: governance.subtitle
};
---

<BaseLayout meta={meta}>
  <main class="governance-page">
    <header class="gov-header">
      <div class="gov-header-inner">
        <a href="/" class="gov-brand" aria-label="العودة إلى الرئيسية">
          <img src={site.assets.logoNav} alt="شعار مؤسسة هدايات التعليمية" />
        </a>
        <nav class="gov-header-actions" aria-label="التنقل">
          <a href="/" class="gov-home"><i class="bi bi-house-door" aria-hidden="true"></i><span>الرئيسية</span></a>
        </nav>
      </div>
    </header>

    <section class="gov-hero">
      <div class="gov-shell">
        <span class="gov-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> الحوكمة</span>
        <h1>{governance.title}</h1>
        <p>{governance.subtitle}</p>
        <div class="gov-summary" aria-label="ملخص الوثائق">
          <div><strong>{governance.official.length}</strong><span>وثائق نظامية</span></div>
          <span class="gov-summary-separator" aria-hidden="true"></span>
          <div><strong>{governance.policies.length}</strong><span>سياسات منشورة</span></div>
        </div>
      </div>
    </section>

    <section class="gov-content">
      <div class="gov-section-heading">
        <div class="gov-section-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></div>
        <div>
          <span>الوثائق الرسمية</span>
          <h2>الوثائق النظامية</h2>
          <p>وثائق تعريف وتنظيم المؤسسة المعتمدة والمرتبطة بوضعها النظامي.</p>
        </div>
      </div>

      <div class="gov-doc-grid gov-doc-grid--official">
        {governance.official.map((doc) => (
          <article class="gov-doc-card gov-doc-card--official">
            <div class="gov-doc-preview">
              <img src={doc.previewHref} alt={`معاينة الصفحة الأولى من ${doc.title}`} loading="lazy" />
              <span class="gov-doc-badge"><i class="bi bi-check2-circle" aria-hidden="true"></i> وثيقة رسمية</span>
            </div>
            <div class="gov-doc-body">
              <div class="gov-doc-meta"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i><span>{doc.meta}</span></div>
              <h3>{doc.title}</h3>
              <p>{doc.description}</p>
              <div class="gov-doc-actions">
                <a class="gov-btn gov-btn--primary" href={`/${doc.fileHref}`} target="_blank" rel="noopener">
                  <i class="bi bi-eye" aria-hidden="true"></i><span>عرض الوثيقة</span>
                </a>
                <a class="gov-btn gov-btn--secondary" href={`/${doc.fileHref}`} download>
                  <i class="bi bi-download" aria-hidden="true"></i><span>تحميل PDF</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="gov-divider" role="presentation"></div>

      <div class="gov-section-heading">
        <div class="gov-section-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></div>
        <div>
          <span>الحوكمة المؤسسية</span>
          <h2>السياسات المعتمدة</h2>
          <p>سياسات منشورة لتنظيم الممارسات المؤسسية وتعزيز الشفافية وحماية البيانات والوثائق.</p>
        </div>
      </div>

      <div class="gov-doc-grid">
        {governance.policies.map((doc) => (
          <article class="gov-doc-card">
            <div class="gov-doc-preview">
              <img src={doc.previewHref} alt={`معاينة الصفحة الأولى من ${doc.title}`} loading="lazy" />
              <span class="gov-doc-badge gov-doc-badge--policy"><i class="bi bi-shield-check" aria-hidden="true"></i> سياسة معتمدة</span>
            </div>
            <div class="gov-doc-body">
              <div class="gov-doc-meta"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>{doc.meta}</span></div>
              <h3>{doc.title}</h3>
              <p>{doc.description}</p>
              <div class="gov-doc-actions">
                <a class="gov-btn gov-btn--primary" href={`/${doc.fileHref}`} target="_blank" rel="noopener">
                  <i class="bi bi-eye" aria-hidden="true"></i><span>عرض السياسة</span>
                </a>
                <a class="gov-btn gov-btn--secondary" href={`/${doc.fileHref}`} download>
                  <i class="bi bi-download" aria-hidden="true"></i><span>تحميل PDF</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="gov-note">
        <div class="gov-note-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></div>
        <p>تُعرض الوثائق بصيغتها الأصلية المعتمدة. يمكن فتح كل ملف مباشرة في المتصفح أو تنزيل نسخة PDF للاطلاع عليها.</p>
      </div>

      <a class="gov-back" href="/"><i class="bi bi-arrow-right" aria-hidden="true"></i> العودة إلى موقع المؤسسة</a>
    </section>
  </main>

  <style>
    :global(body){margin:0;background:#f7f9f8;color:#153847}.governance-page{min-height:100vh;background:linear-gradient(180deg,#fbfcfc 0%,#f4f7f6 100%);font-family:var(--font-family-arabic)}
    .gov-header{position:sticky;top:0;z-index:30;background:rgba(255,255,255,.96);border-bottom:1px solid rgba(8,77,98,.11);backdrop-filter:blur(14px)}
    .gov-header-inner{max-width:1180px;margin:auto;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px}.gov-brand img{display:block;width:188px;max-width:47vw;height:auto}.gov-header-actions{display:flex;align-items:center;gap:10px}.gov-home{display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:#0b5a70;font-weight:800;border:1px solid rgba(11,90,112,.18);padding:9px 16px;border-radius:10px;background:#fff;transition:.2s ease}.gov-home:hover{background:#f2f8f8;border-color:rgba(11,90,112,.32)}
    .gov-hero{position:relative;overflow:hidden;padding:78px 20px 64px;text-align:center;background:linear-gradient(135deg,#f6fbfb 0%,#fff 48%,#fbfaf4 100%);border-bottom:1px solid rgba(8,77,98,.08)}.gov-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(13,94,112,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(13,94,112,.025) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,#000,transparent 84%);pointer-events:none}.gov-shell{position:relative;max-width:820px;margin:auto}.gov-eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:#e9f4f3;color:#0b6170;font-weight:800;margin-bottom:22px;border:1px solid rgba(11,97,112,.08)}.gov-hero h1{font-size:clamp(2.2rem,5vw,4rem);margin:0 0 16px;font-weight:900;color:#0a4155;letter-spacing:-.02em}.gov-hero p{margin:0 auto;max-width:760px;font-size:1.08rem;line-height:2;color:#62747b}.gov-summary{margin:30px auto 0;display:inline-flex;align-items:center;gap:24px;background:#fff;border:1px solid rgba(8,77,98,.1);box-shadow:0 14px 34px rgba(24,64,74,.06);border-radius:16px;padding:14px 24px}.gov-summary>div{display:flex;align-items:baseline;gap:8px}.gov-summary strong{font-size:1.55rem;color:#0a566b}.gov-summary span{font-size:.9rem;color:#75848a;font-weight:700}.gov-summary-separator{width:1px;height:28px;background:rgba(8,77,98,.12)}
    .gov-content{max-width:1180px;margin:0 auto;padding:64px 22px 90px}.gov-section-heading{display:flex;align-items:flex-start;gap:16px;margin-bottom:24px}.gov-section-icon{flex:0 0 52px;width:52px;height:52px;display:grid;place-items:center;border-radius:14px;background:#e9f4f3;color:#0a6473;font-size:24px;border:1px solid rgba(10,100,115,.08)}.gov-section-heading>div:last-child>span{display:block;color:#ad9149;font-size:.86rem;font-weight:900;margin-bottom:4px}.gov-section-heading h2{margin:0 0 5px;font-size:clamp(1.55rem,3vw,2.1rem);font-weight:900;color:#113f50}.gov-section-heading p{margin:0;color:#728087;line-height:1.8}
    .gov-doc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.gov-doc-grid--official{grid-template-columns:repeat(2,minmax(0,1fr))}.gov-doc-card{overflow:hidden;background:#fff;border:1px solid rgba(10,80,98,.11);border-radius:20px;box-shadow:0 12px 38px rgba(21,56,71,.055);display:flex;flex-direction:column;min-width:0}.gov-doc-card--official{display:grid;grid-template-columns:minmax(180px,36%) 1fr;min-height:330px}.gov-doc-preview{position:relative;background:#edf3f2;min-height:248px;overflow:hidden;display:grid;place-items:center;padding:16px}.gov-doc-card--official .gov-doc-preview{min-height:100%}.gov-doc-preview img{display:block;width:100%;height:100%;max-height:310px;object-fit:contain;object-position:center;background:#fff;box-shadow:0 8px 24px rgba(20,52,62,.10);border-radius:3px}.gov-doc-card:not(.gov-doc-card--official) .gov-doc-preview img{height:260px;object-fit:contain;object-position:center}.gov-doc-badge{position:absolute;top:14px;right:14px;display:inline-flex;align-items:center;gap:6px;background:rgba(9,74,91,.93);color:white;border-radius:8px;padding:7px 10px;font-size:.78rem;font-weight:800;box-shadow:0 6px 16px rgba(8,56,71,.17)}.gov-doc-badge--policy{background:rgba(173,145,73,.94)}.gov-doc-body{padding:23px;display:flex;flex-direction:column;flex:1}.gov-doc-meta{display:flex;align-items:center;gap:7px;color:#79898f;font-size:.83rem;font-weight:700;margin-bottom:9px}.gov-doc-meta i{color:#b09247}.gov-doc-body h3{margin:0 0 10px;font-size:1.23rem;line-height:1.55;font-weight:900;color:#173f4e}.gov-doc-body p{margin:0 0 22px;color:#6e7d83;line-height:1.9;font-size:.94rem;flex:1}.gov-doc-actions{display:flex;gap:9px;flex-wrap:wrap}.gov-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;border-radius:10px;padding:10px 14px;font-weight:800;font-size:.9rem;transition:.2s ease}.gov-btn--primary{background:#0b5f72;color:#fff;border:1px solid #0b5f72}.gov-btn--primary:hover{background:#084c5b;color:#fff}.gov-btn--secondary{background:#fff;color:#0b5f72;border:1px solid rgba(11,95,114,.22)}.gov-btn--secondary:hover{background:#f3f8f8;color:#0b5f72}.gov-divider{height:1px;background:linear-gradient(90deg,transparent,rgba(8,77,98,.13),transparent);margin:62px 0}.gov-note{margin-top:34px;display:flex;align-items:flex-start;gap:12px;background:#f0f7f6;border:1px solid rgba(10,100,115,.11);border-radius:14px;padding:17px 18px;color:#5d737a}.gov-note-icon{color:#0b6170;font-size:20px}.gov-note p{margin:0;line-height:1.8;font-size:.92rem}.gov-back{display:inline-flex;align-items:center;gap:8px;margin-top:28px;text-decoration:none;color:#0b5f72;font-weight:800}
    @media(max-width:980px){.gov-doc-grid,.gov-doc-grid--official{grid-template-columns:repeat(2,minmax(0,1fr))}.gov-doc-card--official{display:flex}.gov-doc-card--official .gov-doc-preview{min-height:260px}.gov-doc-card--official .gov-doc-preview img{height:260px;object-fit:contain}}
    @media(max-width:680px){.gov-header-inner{padding:11px 15px}.gov-brand img{width:148px}.gov-home span{display:none}.gov-home{width:42px;height:42px;justify-content:center;padding:0;border-radius:10px}.gov-hero{padding:54px 17px 44px}.gov-hero h1{font-size:2.15rem}.gov-hero p{font-size:.98rem;line-height:1.85}.gov-summary{gap:14px;padding:12px 15px;width:100%;justify-content:center}.gov-summary>div{flex-direction:column;gap:1px;align-items:center}.gov-summary strong{font-size:1.35rem}.gov-content{padding:44px 15px 70px}.gov-section-heading{gap:12px}.gov-section-icon{width:46px;height:46px;flex-basis:46px}.gov-doc-grid,.gov-doc-grid--official{grid-template-columns:1fr}.gov-doc-preview,.gov-doc-card--official .gov-doc-preview{min-height:245px;padding:14px}.gov-doc-preview img,.gov-doc-card--official .gov-doc-preview img{height:245px;object-fit:contain}.gov-doc-body{padding:20px}.gov-doc-actions{display:grid;grid-template-columns:1fr 1fr}.gov-btn{width:100%;padding:10px 8px}.gov-divider{margin:46px 0}}
  </style>
</BaseLayout>
