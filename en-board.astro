---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../content/site-en.json";
const meta = {
  ...site.meta,
  title: "Organizational Management | Hedayat Educational Foundation",
  description: "Organizational structure and Board of Trustees of Hedayat Educational Foundation."
};
---
<BaseLayout meta={meta} lang="en" dir="ltr" skipLabel="Skip to main content" accessibilityLabel="Accessibility tools">
  <main id="main-content" class="institution-page">
    <header class="institution-header">
      <div class="institution-header-inner">
        <a href="/en/" class="institution-brand" aria-label="Back to Home">
          <img src={site.assets.logoNav} alt="Hedayat Educational Foundation logo" />
        </a>
        <a href="/en/" class="institution-home"><i class="bi bi-house-door" aria-hidden="true"></i><span>Home</span></a>
      </div>
    </header>

    <section class="institution-hero">
      <div class="institution-shell">
        <span class="institution-eyebrow">About the Foundation</span>
        <div class="institution-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></div>
        <h1 id="org-title">Organizational Management</h1>
        <p>The organizational structure of Hedayat Educational Foundation and its Board of Trustees.</p>
        <nav class="org-jump" aria-label="Page sections">
          <a href="#structure"><i class="bi bi-diagram-3" aria-hidden="true"></i> Organizational Structure</a>
          <a href="#trustees"><i class="bi bi-people" aria-hidden="true"></i> Board of Trustees</a>
        </nav>
      </div>
    </section>

    <section id="structure" class="institution-content org-block" aria-labelledby="structure-title">
      <h2 id="structure-title" class="org-block-title">Organizational Structure</h2>
      <div class="org-chart-en">
        <ul class="org-tree">
          <li>
            <span class="org-node org-node--top">Board of Trustees</span>
            <ul>
              <li>
                <span class="org-node org-node--top">Executive Director</span>
                <ul class="org-depts">
                  <li><span class="org-node org-node--dept">Financial Affairs</span><ul><li><span class="org-node">Accountant</span></li></ul></li>
                  <li><span class="org-node org-node--dept">Program Supervision</span><ul class="org-pair"><li><span class="org-node">Program Officer</span></li><li><span class="org-node">Program Officer</span></li></ul></li>
                  <li><span class="org-node org-node--dept">Media &amp; Design</span><ul><li><span class="org-node">Designer</span></li></ul></li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </section>

    <div class="org-separator" aria-hidden="true"><span></span><i class="bi bi-diamond-fill"></i><span></span></div>

    <section id="trustees" class="institution-content org-block trustees-section" aria-labelledby="trustees-title">
      <h2 id="trustees-title" class="org-block-title">Board of Trustees</h2>
      <ul class="trustees-list-en" aria-label="Board of Trustees members">
        {[
          { role: "Chair of the Board of Trustees", name: "Haneen Fahad Al-Sudairi", icon: "bi bi-award" },
          { role: "Vice Chair of the Board", name: "Jumana Talal Mahjoub", icon: "bi bi-person-badge" },
          { role: "Board Member", name: "Amani Bashir Al-Juhani", icon: "bi bi-person" }
        ].map((m) => (
          <li class="trustee-en-card">
            <span class="trustee-en-icon" aria-hidden="true"><i class={m.icon}></i></span>
            <strong>{m.name}</strong>
            <span class="trustee-en-role">{m.role}</span>
          </li>
        ))}
      </ul>
      {site.docs.trustees.boardFile && (
        <div class="board-file-row">
          <a class="board-file-btn" href={site.docs.trustees.boardFile.href} target="_blank" rel="noopener noreferrer">
            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Board profile (Arabic PDF)
            {site.docs.trustees.boardFile.status && <em>{site.docs.trustees.boardFile.status}</em>}
          </a>
        </div>
      )}
      <a class="institution-back" href="/en/#about"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to About the Foundation</a>
    </section>
  </main>

  <style>
    :global(body){margin:0;background:#f7f4ee;color:#334137}.institution-page{min-height:100vh;background:linear-gradient(180deg,#fbfaf7 0%,#f5f1e8 100%);font-family:var(--font-family-arabic)}
    .institution-header{position:sticky;top:0;z-index:20;background:rgba(251,250,247,.96);border-bottom:1px solid rgba(102,122,82,.17);backdrop-filter:blur(12px)}.institution-header-inner{max-width:1180px;margin:auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px}.institution-brand img{display:block;width:190px;max-width:47vw;height:auto}.institution-home{display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:#5e734a;font-weight:800;border:1px solid rgba(94,115,74,.22);padding:9px 16px;border-radius:999px;background:#fff}
    .institution-hero{padding:72px 20px 44px;text-align:center;background:radial-gradient(circle at 50% 0%,rgba(231,158,113,.14),transparent 42%)}.institution-shell{max-width:760px;margin:auto}.institution-eyebrow{display:inline-flex;padding:7px 16px;border-radius:999px;background:#eef2e8;color:#5e734a;font-weight:800;margin-bottom:22px}.institution-icon{width:74px;height:74px;margin:0 auto 18px;display:grid;place-items:center;border-radius:22px;background:#fff4ea;color:#de8f62;font-size:31px;box-shadow:0 12px 30px rgba(51,65,55,.08)}h1{font-size:clamp(2.2rem,5vw,3.8rem);margin:0 0 14px;font-weight:900;color:#334137}.institution-hero p{margin:0 auto;max-width:720px;font-size:1.12rem;line-height:2;color:#667267}
    .institution-content{max-width:1100px;margin:0 auto;padding:0 20px 88px;scroll-margin-top:100px}.trustees-card{margin:0;background:#fff;border:1px solid rgba(94,115,74,.13);border-radius:26px;padding:16px;box-shadow:0 20px 56px rgba(51,65,55,.07);overflow:hidden}.trustees-card img{display:block;width:100%;height:auto;border-radius:18px}.institution-back{display:inline-flex;align-items:center;gap:8px;margin-top:26px;text-decoration:none;color:#5e734a;font-weight:800}
    @media(max-width:720px){.institution-header-inner{padding:12px 16px}.institution-brand img{width:150px}.institution-home span{display:none}.institution-home{width:42px;height:42px;justify-content:center;padding:0}.institution-hero{padding:52px 18px 34px}.institution-content{padding:0 12px 70px}.trustees-card{padding:8px;border-radius:18px}.trustees-card img{border-radius:12px}}
  
    /* unified-mobile-v1: consistent internal-page scale */
    @media(max-width:600px){
      h1{font-size:clamp(1.85rem,9vw,2.35rem)!important;line-height:1.35!important}
      h2{line-height:1.45}
      .media-hero p,.gov-hero p,.transparency-hero p,.institution-hero p,.participation-hero p,.access-hero p,.reports-hero p{font-size:.96rem!important;line-height:1.85!important}
      .media-hero,.gov-hero,.transparency-hero,.institution-hero,.participation-hero,.access-hero,.reports-hero{padding-top:42px!important;padding-bottom:34px!important}
      .media-brand img,.gov-brand img,.institution-brand img,.access-header img,.reports-header img{width:138px!important}
    }
    .trustees-list-en{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .trustee-en-card{background:#fff;border:1px solid rgba(94,115,74,.13);border-radius:22px;padding:30px 22px;text-align:center;box-shadow:0 20px 56px rgba(51,65,55,.07);display:flex;flex-direction:column;align-items:center;gap:8px}
    .trustee-en-icon{width:58px;height:58px;display:grid;place-items:center;border-radius:18px;background:#eef2e8;color:#5e734a;font-size:25px;margin-bottom:6px}
    .trustee-en-card strong{font-size:1.12rem;color:#334137}
    .trustee-en-role{color:#667267;font-size:.95rem}
    @media(max-width:820px){.trustees-list-en{grid-template-columns:1fr}}

    .org-jump{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:24px}
    .org-jump a{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:999px;background:#fff;border:1px solid rgba(40,101,131,.2);color:#286583;font-weight:800;text-decoration:none}
    .org-jump a:hover{background:#e7f0f4}
    .org-block{padding-bottom:0}
    .org-block-title{display:flex;align-items:center;gap:12px;margin:0 0 18px;font-size:clamp(1.35rem,2.6vw,1.8rem);font-weight:900;color:#286583}
    .org-block-title::before{content:"";width:6px;height:1.4em;border-radius:6px;background:linear-gradient(#BEAE59,#E69D74)}
    .org-separator{max-width:1100px;margin:56px auto;padding:0 20px;display:flex;align-items:center;gap:14px;color:#BEAE59}
    .org-separator span{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(190,174,89,.6),transparent)}
    .org-separator i{font-size:.8rem}
    #trustees{padding-bottom:88px}
    .org-chart-en{background:#fff;border:1px solid rgba(94,115,74,.13);border-radius:26px;padding:40px 20px;box-shadow:0 20px 56px rgba(51,65,55,.07);overflow-x:auto}
    .org-tree,.org-tree ul{list-style:none;margin:0;padding:0}
    .org-tree ul{display:flex;justify-content:center;position:relative}
    .org-tree li{position:relative;display:flex;flex-direction:column;align-items:center;padding:26px 10px 0}
    .org-tree>li{padding-top:0}
    .org-tree li::before{content:"";position:absolute;top:0;left:50%;height:26px;border-left:2px solid #96BDBC}
    .org-tree>li::before{display:none}
    .org-tree ul::before{content:"";position:absolute;top:-26px;left:50%;height:26px;border-left:2px solid #96BDBC}
    .org-tree ul>li{padding-top:26px}
    .org-tree ul>li::after{content:"";position:absolute;top:0;left:0;right:0;border-top:2px solid #96BDBC}
    .org-tree ul>li:first-child::after{left:50%}
    .org-tree ul>li:last-child::after{right:50%}
    .org-tree ul>li:only-child::after{display:none}
    .org-tree ul{padding-top:0;margin-top:26px}
    .org-node{display:inline-flex;align-items:center;justify-content:center;text-align:center;min-width:150px;min-height:52px;padding:10px 18px;border-radius:12px;background:#1F5A78;color:#fff;font-weight:800;line-height:1.35}
    .org-node--top{min-width:220px}
    .org-node--dept{background:#96BDBC;color:#173f4e;min-width:180px}
    .org-pair .org-node{min-width:120px}
    @media(max-width:820px){
      .org-chart-en{padding:24px 14px}
      .org-depts{flex-direction:column;align-items:stretch}
      .org-depts::before{display:none}
      .org-depts>li::after{display:none}
      .org-depts>li{padding-top:18px}
      .org-depts>li::before{height:18px}
      .org-node,.org-node--top,.org-node--dept{min-width:0;width:min(100%,260px)}
      .org-pair .org-node{min-width:0;width:auto}
      .org-separator{margin:36px auto}#trustees{padding-bottom:70px}
    }
    .board-file-row{display:flex;justify-content:center;margin-top:24px}
    .board-file-btn{display:inline-flex;align-items:center;gap:10px;padding:12px 22px;border-radius:999px;background:#286583;color:#fff;font-weight:800;text-decoration:none}
    .board-file-btn:hover{background:#1f5169;color:#fff}
    .board-file-btn em{font-style:normal;font-size:.75rem;padding:2px 9px;border-radius:999px;background:rgba(255,255,255,.18)}
  </style>
</BaseLayout>
