---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../content/site-en.json";
const meta = {
  ...site.meta,
  title: "Accessibility Statement | Hedayat Educational Foundation",
  description: "Digital accessibility statement for the Hedayat Educational Foundation website, including ways to request assistance or report an accessibility barrier."
};
---
<BaseLayout meta={meta} lang="en" dir="ltr" skipLabel="Skip to main content" accessibilityLabel="Accessibility tools">
  <main id="main-content" class="access-page">
    <header class="access-header">
      <div class="access-header-inner">
        <a href="/en/" aria-label="Back to Home"><img src={site.assets.logoNav} alt="Hedayat Educational Foundation logo" /></a>
        <div class="access-header-actions">
          <a href="/en/#accessibility" lang="en" dir="ltr">EN</a>
          <a href="/en/"><i class="bi bi-house-door" aria-hidden="true"></i><span>Home</span></a>
        </div>
      </div>
    </header>

    <section class="access-hero" aria-labelledby="access-title">
      <div class="access-shell">
        <span><i class="bi bi-person-check" aria-hidden="true"></i> Digital Accessibility</span>
        <h1 id="access-title">Accessibility Statement</h1>
        <p>Hedayat Educational Foundation works to make its website clearer and easier to use for as many visitors as possible, including keyboard and screen-reader users, older adults, and people with different accessibility needs.</p>
      </div>
    </section>

    <section class="access-content">
      <article class="access-callout">
        <div class="access-callout-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></div>
        <div>
          <h2>Target Level</h2>
          <p>Website improvements are guided by WCAG 2.2 principles, with AA-level conformance targeted where reasonably possible. This statement is not an external audit certificate or a claim of formal certification.</p>
        </div>
      </article>

      <div class="access-grid">
        <article><i class="bi bi-keyboard" aria-hidden="true"></i><h2>Keyboard Navigation</h2><p>Links, buttons, and form controls can be reached using the keyboard, with a visible focus indicator and a skip link to the main content.</p></article>
        <article><i class="bi bi-fonts" aria-hidden="true"></i><h2>Text Resizing</h2><p>All pages include controls to decrease, reset, or increase text size, and the user’s preference is saved on the device.</p></article>
        <article><i class="bi bi-circle-half" aria-hidden="true"></i><h2>High Contrast</h2><p>The website provides a high-contrast option that improves text, border, and link visibility and does not rely on color alone to communicate important states.</p></article>
        <article><i class="bi bi-card-image" aria-hidden="true"></i><h2>Image Text Alternatives</h2><p>Meaningful images include alternative text, while decorative elements are ignored by assistive technologies to reduce unnecessary noise.</p></article>
        <article><i class="bi bi-camera-video" aria-hidden="true"></i><h2>Video Content</h2><p>The currently published video is silent, so its page includes a structured visual description of the main scenes. Captions will be added when future published videos include speech and captions are available.</p></article>
        <article><i class="bi bi-phone" aria-hidden="true"></i><h2>Responsive Layout</h2><p>Cards, menus, and content sizes adapt to phones, tablets, and desktop screens while avoiding horizontal scrolling where possible.</p></article>
      </div>

      <section class="access-help" aria-labelledby="access-help-title">
        <div>
          <span>Did you encounter a barrier?</span>
          <h2 id="access-help-title">Help Us Improve Accessibility</h2>
          <p>If you have difficulty reading content or using an element on the website, send a brief description of the issue and the page where it occurred, and we will review it.</p>
        </div>
        <div class="access-help-actions">
          <a href={`mailto:${site.contact.email}?subject=${encodeURIComponent('Accessibility at Hedayat')}`}><i class="bi bi-envelope" aria-hidden="true"></i> Email</a>
          <a href="/en/#contact"><i class="bi bi-chat-left-text" aria-hidden="true"></i> Contact Form</a>
        </div>
      </section>

      <p class="access-updated"><i class="bi bi-calendar-check" aria-hidden="true"></i> Statement last updated: 20 September 2026</p>
    </section>
  </main>

  <style>
    :global(body){margin:0;background:#f7f8f5;color:#35433a}.access-page{min-height:100vh;font-family:var(--font-family-arabic)}.access-header{position:sticky;top:0;z-index:25;background:rgba(255,255,255,.97);border-bottom:1px solid rgba(100,117,80,.14);backdrop-filter:blur(12px)}.access-header-inner{max-width:1120px;margin:auto;padding:12px 22px;display:flex;justify-content:space-between;align-items:center;gap:15px}.access-header img{display:block;width:180px;max-width:44vw;height:auto}.access-header-actions{display:flex;gap:8px}.access-header-actions a{display:inline-flex;align-items:center;gap:7px;padding:9px 12px;border:1px solid rgba(100,117,80,.2);border-radius:10px;color:#526441;background:#fff;font-weight:900;text-decoration:none}
    .access-hero{padding:72px 20px 55px;text-align:center;background:linear-gradient(135deg,#f0f4ea,#fff 58%,#edf5f4)}.access-shell{max-width:830px;margin:auto}.access-shell>span{display:inline-flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;background:#eaf0e3;color:#526441;font-weight:900}.access-hero h1{font-size:clamp(2.2rem,5vw,3.8rem);margin:17px 0 12px;color:#35483a;font-weight:900}.access-hero p{margin:auto;max-width:800px;line-height:2;color:#637168;font-size:1.04rem}
    .access-content{max-width:1120px;margin:auto;padding:52px 20px 90px}.access-callout{display:flex;gap:18px;align-items:flex-start;padding:24px;background:#fff;border:1px solid rgba(100,117,80,.14);border-radius:20px;box-shadow:0 12px 32px rgba(61,75,64,.06)}.access-callout-icon{width:58px;height:58px;flex:0 0 58px;display:grid;place-items:center;border-radius:15px;background:#eaf0e3;color:#526441;font-size:27px}.access-callout h2{margin:0 0 7px;color:#394a3d;font-size:1.35rem}.access-callout p{margin:0;color:#657268;line-height:1.9}.access-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}.access-grid article{background:#fff;border:1px solid rgba(100,117,80,.12);border-radius:18px;padding:23px;box-shadow:0 10px 28px rgba(61,75,64,.045)}.access-grid article>i{width:48px;height:48px;display:grid;place-items:center;border-radius:13px;background:#edf3e8;color:#526441;font-size:23px}.access-grid h2{font-size:1.1rem;margin:15px 0 7px;color:#394a3d}.access-grid p{margin:0;color:#68746b;line-height:1.85}.access-help{margin-top:32px;display:flex;align-items:center;justify-content:space-between;gap:25px;padding:26px;border-radius:20px;background:#315f70;color:#fff}.access-help span{color:#f1dda0;font-size:.86rem;font-weight:900}.access-help h2{margin:3px 0 6px;font-size:1.45rem;font-weight:900}.access-help p{margin:0;max-width:650px;color:#e6eef0;line-height:1.8}.access-help-actions{display:flex;flex-direction:column;gap:9px;min-width:190px}.access-help-actions a{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#fff;color:#244e5e;border-radius:10px;padding:10px 13px;text-decoration:none;font-weight:900}.access-updated{text-align:center;color:#69766c;margin:24px 0 0;font-size:.9rem}
    @media(max-width:850px){.access-grid{grid-template-columns:1fr 1fr}.access-help{align-items:flex-start;flex-direction:column}.access-help-actions{width:100%;display:grid;grid-template-columns:1fr 1fr}}
    @media(max-width:600px){.access-header-inner{padding:11px 14px}.access-header img{width:142px}.access-header-actions a span{display:none}.access-hero{padding:50px 16px 40px}.access-content{padding:40px 14px 70px}.access-callout{flex-direction:column}.access-grid{grid-template-columns:1fr}.access-help-actions{grid-template-columns:1fr}}
  
    /* unified-mobile-v1: consistent internal-page scale */
    @media(max-width:600px){
      h1{font-size:clamp(1.85rem,9vw,2.35rem)!important;line-height:1.35!important}
      h2{line-height:1.45}
      .media-hero p,.gov-hero p,.transparency-hero p,.institution-hero p,.participation-hero p,.access-hero p,.reports-hero p{font-size:.96rem!important;line-height:1.85!important}
      .media-hero,.gov-hero,.transparency-hero,.institution-hero,.participation-hero,.access-hero,.reports-hero{padding-top:42px!important;padding-bottom:34px!important}
      .media-brand img,.gov-brand img,.institution-brand img,.access-header img,.reports-header img{width:138px!important}
    }
  </style>
</BaseLayout>
